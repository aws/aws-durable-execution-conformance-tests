{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aws-durable-execution-conformance:lmi-evidence:1",
  "title": "LMI lifecycle final evidence v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "requirementId",
    "runtime",
    "runId",
    "caseId",
    "artifact",
    "profile",
    "selectedRequests",
    "attempts",
    "events",
    "sdkRequests",
    "histories",
    "expectedHistories",
    "observationEndedAtMs",
    "collection",
    "resourcesCreated",
    "faultsCreated",
    "retirement"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "requirementId": {
      "enum": [
        "lmi-lifecycle-1",
        "lmi-lifecycle-2",
        "lmi-lifecycle-3",
        "lmi-lifecycle-4",
        "lmi-lifecycle-5",
        "lmi-lifecycle-6",
        "lmi-lifecycle-7"
      ]
    },
    "runtime": {
      "enum": [
        "javascript",
        "java",
        "python"
      ]
    },
    "runId": {
      "$ref": "#/$defs/nonBlankString"
    },
    "caseId": {
      "$ref": "#/$defs/nonBlankString"
    },
    "artifact": {
      "type": "object",
      "required": [
        "sdk",
        "conformance"
      ],
      "properties": {
        "sdk": {
          "$ref": "#/$defs/nonBlankString"
        },
        "conformance": {
          "$ref": "#/$defs/nonBlankString"
        }
      }
    },
    "profile": {
      "type": "object",
      "required": [
        "functionArn",
        "configurationDigest",
        "nativeConcurrency",
        "timeoutMs"
      ],
      "properties": {
        "functionArn": {
          "$ref": "#/$defs/nonBlankString"
        },
        "configurationDigest": {
          "$ref": "#/$defs/nonBlankString"
        },
        "nativeConcurrency": {
          "type": "integer",
          "minimum": 1
        },
        "timeoutMs": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "recoveryPolicy": {
          "enum": [
            "reuse-worker",
            "replace-worker"
          ]
        }
      }
    },
    "selectedRequests": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/nonBlankString"
      }
    },
    "attempts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/attempt"
      },
      "minItems": 1
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      },
      "minItems": 1
    },
    "sdkRequests": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/request"
      }
    },
    "collectionErrors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonBlankString"
      }
    },
    "histories": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/history"
      },
      "minItems": 1
    },
    "budgets": {
      "type": "object",
      "properties": {
        "admissionMs": {
          "type": "number",
          "minimum": 0
        },
        "cleanupMs": {
          "type": "number",
          "minimum": 0
        },
        "recoveryMs": {
          "type": "number",
          "minimum": 0
        },
        "observationGraceMs": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "replay": {
      "type": "object",
      "properties": {
        "before": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/completedOperation"
          }
        },
        "after": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/operation"
          },
          "$comment": "Semantic validation identifies retry.operationId in this array and the collected final history, requires SUCCEEDED and a stored result key (including JSON null), and permits unrelated pending operations without a result. JSON Schema cannot express this cross-record ID comparison."
        },
        "projectionErrors": {
          "type": "array",
          "items": {"type": "string", "pattern": "\\S"}
        },
        "expectedBefore": {
          "type": "array",
          "items": {"$ref": "#/$defs/operation"}
        },
        "durableWaitObserved": {
          "type": "boolean"
        },
        "suspensionCheckpointMatches": {
          "type": "boolean"
        },
        "operationExecutions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "requestId",
              "operationId"
            ],
            "properties": {
              "requestId": {
                "$ref": "#/$defs/nonBlankString"
              },
              "operationId": {
                "$ref": "#/$defs/nonBlankString"
              }
            }
          }
        },
        "retry": {
          "type": "object",
          "required": [
            "operationId",
            "attempts"
          ],
          "properties": {
            "operationId": {
              "$ref": "#/$defs/nonBlankString"
            },
            "attempts": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/retryAttempt"
              }
            }
          }
        },
        "missingExpectedEffects": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "sideEffects": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sideEffect"
          }
        }
      },
      "if": {
        "required": ["missingExpectedEffects"],
        "properties": {
          "missingExpectedEffects": {"contains": {"const": "retry"}}
        }
      },
      "else": {
        "properties": {
          "retry": {
            "properties": {
              "attempts": {"minItems": 2}
            }
          }
        }
      }
    },
    "expectedHistories": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "dependentRequired": {"resultFingerprint": ["result"]},
        "properties": {
          "resultFingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "status": {
            "enum": [
              "SUCCEEDED",
              "FAILED",
              "TIMED_OUT",
              "STOPPED",
              "RUNNING",
              "PAUSING",
              "PAUSED",
              "PENDING"
            ]
          },
          "allowedStatuses": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "SUCCEEDED",
                "FAILED",
                "TIMED_OUT",
                "STOPPED",
                "RUNNING",
                "PAUSING",
                "PAUSED",
                "PENDING"
              ]
            }
          }
        },
        "oneOf": [
          {
            "required": [
              "status"
            ],
            "not": {
              "required": [
                "allowedStatuses"
              ]
            }
          },
          {
            "required": [
              "allowedStatuses"
            ],
            "not": {
              "required": [
                "status"
              ]
            }
          }
        ],
        "anyOf": [
          {
            "required": [
              "result"
            ]
          },
          {
            "required": [
              "error"
            ]
          },
          {
            "required": [
              "allowedStatuses"
            ],
            "properties": {
              "allowedStatuses": {
                "contains": {
                  "enum": ["RUNNING", "PAUSING", "PAUSED"]
                }
              }
            }
          }
        ]
      }
    },
    "observationEndedAtMs": {
      "type": "number",
      "minimum": 0
    },
    "collection": {
      "type": "object",
      "required": [
        "watermarks",
        "evidenceUris"
      ],
      "properties": {
        "deferredServiceRequests": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["requestId", "executionArn"],
            "properties": {
              "requestId": {"type": "string", "pattern": "\\S"},
              "executionArn": {"type": "string", "pattern": "\\S"}
            }
          }
        },
        "watermarks": {
          "type": "object",
          "required": [
            "lifecycle",
            "sdkRequests",
            "history"
          ],
          "properties": {
            "lifecycle": {
              "type": "number",
              "minimum": 0
            },
            "sdkRequests": {
              "type": "number",
              "minimum": 0
            },
            "history": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "evidenceUris": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonBlankString"
          }
        }
      }
    },
    "resourcesCreated": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resource"
      }
    },
    "faultsCreated": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fault"
      },
      "$comment": "Optional releasedAtMs records a fixture release receipt or retained release observation. Final semantic validation bounds it by retiredAtMs independently of the provider acknowledgment in retirement.faults; neither observer timestamp is guaranteed to precede the other."
    },
    "retirement": {
      "type": "object",
      "required": [
        "retiredAtMs",
        "resources",
        "faults"
      ],
      "properties": {
        "retiredAtMs": {
          "type": "number",
          "minimum": 0
        },
        "completions": {
          "type": "array",
          "items": { "$ref": "#/$defs/event" }
        },
        "resources": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/resource"
              },
              {
                "type": "object",
                "required": [
                  "settledAtMs",
                  "evidenceUri",
                  "outcome"
                ],
                "properties": {
                  "settledAtMs": {
                    "type": "number",
                    "minimum": 0
                  },
                  "evidenceUri": {
                    "$ref": "#/$defs/nonBlankString"
                  },
                  "outcome": {
                    "$ref": "#/$defs/nonBlankString"
                  }
                }
              },
              {
                "if": {
                  "properties": { "kind": { "const": "invocation" } },
                  "required": ["kind"]
                },
                "then": {
                  "properties": { "outcome": { "enum": ["QUIESCENT", "UNDISPATCHED"] } }
                }
              },
              {
                "$comment": "The UNDISPATCHED allowlist and its behavior-mode rejection are enforced by the Python validator, not this wire schema.",
                "if": {
                  "properties": {
                    "kind": { "const": "invocation" },
                    "outcome": { "const": "UNDISPATCHED" }
                  },
                  "required": ["kind", "outcome"]
                },
                "then": {
                  "type": "object",
                  "required": [
                    "executionArn",
                    "serviceErrorType",
                    "sourceEventId",
                    "startedAtMs"
                  ],
                  "properties": {
                    "executionArn": {
                      "$ref": "#/$defs/nonBlankString"
                    },
                    "serviceErrorType": {
                      "$ref": "#/$defs/nonBlankString"
                    },
                    "sourceEventId": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "startedAtMs": {
                      "type": "number",
                      "minimum": 0
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": { "kind": { "const": "execution" } },
                  "required": ["kind"]
                },
                "then": {
                  "properties": {
                    "outcome": { "enum": ["SUCCEEDED", "FAILED", "TIMED_OUT", "STOPPED"] }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "callback"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                },
                "then": {
                  "properties": {
                    "outcome": {
                      "enum": [
                        "SUCCEEDED",
                        "FAILED",
                        "TIMED_OUT"
                      ]
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "control"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                },
                "then": {
                  "properties": {
                    "outcome": {
                      "enum": [
                        "DELETED"
                      ]
                    }
                  }
                }
              }
            ]
          }
        },
        "faults": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/fault"
              },
              {
                "type": "object",
                "required": [
                  "releasedAtMs",
                  "mode"
                ],
                "properties": {
                  "releasedAtMs": {
                    "type": "number",
                    "minimum": 0
                  },
                  "mode": {
                    "enum": [
                      "normal",
                      "emergency"
                    ]
                  }
                }
              }
            ]
          },
          "$comment": "releasedAtMs records provider release acknowledgment or retained release confirmation. Semantic validation bounds this timestamp and any faultsCreated release receipt by retiredAtMs without imposing an order between the independent observers."
        }
      }
    },
    "coverageProfile": {
      "enum": [
        "standard"
      ],
      "default": "standard"
    },
    "scenario": {
      "$ref": "#/$defs/nonBlankString"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "requirementId": {
            "enum": [
              "lmi-lifecycle-3",
              "lmi-lifecycle-4"
            ]
          }
        },
        "required": [
          "requirementId"
        ]
      },
      "then": {
        "required": [
          "budgets"
        ],
        "properties": {
          "budgets": {
            "required": [
              "admissionMs",
              "cleanupMs",
              "observationGraceMs"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "requirementId": {
            "const": "lmi-lifecycle-4"
          }
        },
        "required": [
          "requirementId"
        ]
      },
      "then": {
        "properties": {
          "budgets": {
            "required": [
              "recoveryMs"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "requirementId": {
            "const": "lmi-lifecycle-5"
          }
        },
        "required": [
          "requirementId"
        ]
      },
      "then": {
        "required": [
          "replay"
        ],
        "properties": {
          "replay": {
            "required": [
              "before",
              "after",
              "operationExecutions",
              "sideEffects"
            ],
            "anyOf": [
              {
                "required": ["retry"]
              },
              {
                "required": ["missingExpectedEffects"],
                "properties": {
                  "missingExpectedEffects": {
                    "contains": {"const": "retry"}
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": ["requirementId"],
        "properties": {
          "requirementId": {"not": {"enum": ["lmi-lifecycle-3", "lmi-lifecycle-4"]}}
        }
      },
      "then": {
        "properties": {
          "attempts": {"items": {"not": {"required": ["activeAtObservationEnd"]}}}
        }
      }
    }
  ],
  "$defs": {
    "nonBlankString": {
      "type": "string",
      "pattern": "\\S"
    },
    "attempt": {
      "type": "object",
      "required": [
        "requestId",
        "executionArn",
        "environmentId",
        "workerId",
        "processId",
        "role",
        "attempt",
        "startedAtMs"
      ],
      "properties": {
        "requestId": {
          "$ref": "#/$defs/nonBlankString"
        },
        "executionArn": {
          "$ref": "#/$defs/nonBlankString"
        },
        "environmentId": {
          "$ref": "#/$defs/nonBlankString"
        },
        "workerId": {
          "$ref": "#/$defs/nonBlankString"
        },
        "processId": {
          "$ref": "#/$defs/nonBlankString"
        },
        "role": {
          "$ref": "#/$defs/nonBlankString"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "startedAtMs": {
          "type": "number",
          "minimum": 0
        },
        "activeAtObservationEnd": {
          "const": true
        },
        "endedAtMs": {
          "type": "number",
          "minimum": 0
        },
        "startedAtMsSource": {
          "enum": ["platform", "fixture"]
        },
        "endedAtMsSource": {
          "enum": ["platform", "fixture"]
        },
        "outcome": {
          "enum": [
            "SUCCEEDED",
            "FAILED",
            "PENDING",
            "TIMED_OUT"
          ]
        }
      },
      "if": {
        "required": ["activeAtObservationEnd"]
      },
      "then": {
        "properties": {
          "attempt": {"minimum": 2},
          "role": {"const": "victim"}
        },
        "not": {
          "anyOf": [
            {"required": ["endedAtMs"]},
            {"required": ["outcome"]}
          ]
        }
      },
      "else": {
        "required": ["endedAtMs", "outcome"]
      }
    },
    "event": {
      "type": "object",
      "required": [
        "requestId",
        "ownerRequestId",
        "executionArn",
        "kind",
        "atMs"
      ],
      "properties": {
        "requestId": {
          "$ref": "#/$defs/nonBlankString"
        },
        "observedDuringRequestId": {
          "anyOf": [{ "$ref": "#/$defs/nonBlankString" }, { "type": "null" }]
        },
        "ownerRequestId": {
          "$ref": "#/$defs/nonBlankString"
        },
        "executionArn": {
          "$ref": "#/$defs/nonBlankString"
        },
        "kind": {
          "$ref": "#/$defs/nonBlankString"
        },
        "atMs": {
          "type": "number",
          "minimum": 0
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "admission_probe"
              }
            }
          },
          "then": {
            "required": [
              "probe",
              "outcome"
            ],
            "properties": {
              "probe": {
                "enum": [
                  "operation",
                  "checkpoint"
                ]
              },
              "outcome": {
                "enum": [
                  "ACCEPTED",
                  "REJECTED"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": { "kind": { "enum": ["checkpoint_call", "poll_call"] } }
          },
          "then": {
            "required": ["callId"],
            "properties": {
              "callId": { "$ref": "#/$defs/nonBlankString" },
              "outcome": { "enum": ["DISPATCHED", "REJECTED"] }
            }
          }
        }
      ],
      "$comment": "Independent physical retirement additionally requires unique nonnegative integer sequence per request; wrapper_enter and wrapper_return or wrapper_raise; task_start/task_exit by taskId including root; io_start/io_exit by distinct interval taskId; checkpoint_call/checkpoint_exit and poll_call/poll_exit by callId. Dispatched checkpoint and state-poll SDK requests must match an observed start by requestId, callId and atMs in the independent retirement audit. Behavior observations do not require the complete physical stream. See evidence-schema.md. Physical retirement locally restores observed_task_start/observed_task_exit only with matching sourceKind, rejects malformed or unknown observed_task aliases, and audits their complete work pairs without changing behavior evidence."
    },
    "request": {
      "type": "object",
      "required": [
        "requestId",
        "ownerRequestId",
        "executionArn",
        "method",
        "atMs",
        "outcome"
      ],
      "properties": {
        "requestId": {
          "$ref": "#/$defs/nonBlankString"
        },
        "observedDuringRequestId": {
          "anyOf": [{ "$ref": "#/$defs/nonBlankString" }, { "type": "null" }]
        },
        "ownerRequestId": {
          "$ref": "#/$defs/nonBlankString"
        },
        "executionArn": {
          "$ref": "#/$defs/nonBlankString"
        },
        "method": {
          "$ref": "#/$defs/nonBlankString"
        },
        "atMs": {
          "type": "number",
          "minimum": 0
        },
        "updates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "type", "action"],
            "properties": {
              "id": { "$ref": "#/$defs/nonBlankString" },
              "type": { "$ref": "#/$defs/nonBlankString" },
              "action": { "$ref": "#/$defs/nonBlankString" }
            }
          }
        },
        "outcome": {
          "enum": [
            "DISPATCHED",
            "REJECTED"
          ]
        }
      }
    },
    "operation": {
      "type": "object",
      "required": [
        "id",
        "name",
        "type",
        "status",
        "parentId"
      ],
      "dependentRequired": {
        "resultEncoding": ["result"],
        "resultFingerprint": ["resultEncoding", "result"]
      },
      "dependentSchemas": {
        "resultFingerprint": {
          "properties": {"resultEncoding": {"const": "json"}}
        }
      },
      "properties": {
        "id": {
          "$ref": "#/$defs/nonBlankString"
        },
        "name": {
          "anyOf": [
            { "$ref": "#/$defs/nonBlankString" },
            { "type": "null" }
          ]
        },
        "type": {
          "$ref": "#/$defs/nonBlankString"
        },
        "resultEncoding": {"enum": ["json", "raw"]},
        "resultFingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "status": {
          "$ref": "#/$defs/nonBlankString"
        },
        "parentId": {
          "anyOf": [{ "$ref": "#/$defs/nonBlankString" }, { "type": "null" }]
        },
        "startedAtMs": {
          "type": "number",
          "minimum": 0
        },
        "endedAtMs": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "history": {
      "type": "object",
      "required": [
        "executionArn",
        "ownerCaseId",
        "status",
        "operations"
      ],
      "dependentRequired": {"resultFingerprint": ["result"]},
      "properties": {
        "resultFingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "executionArn": {
          "$ref": "#/$defs/nonBlankString"
        },
        "ownerCaseId": {
          "$ref": "#/$defs/nonBlankString"
        },
        "status": {
          "enum": [
            "SUCCEEDED",
            "FAILED",
            "TIMED_OUT",
            "STOPPED",
            "RUNNING",
            "PAUSING",
            "PAUSED",
            "PENDING"
          ]
        },
        "operations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/operation"
          }
        },
        "startedAtMs": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "resource": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "ownerCaseId"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonBlankString"
        },
        "kind": {
          "enum": ["invocation", "execution", "callback", "control"]
        },
        "ownerCaseId": {
          "$ref": "#/$defs/nonBlankString"
        }
      }
    },
    "fault": {
      "type": "object",
      "required": [
        "id",
        "ownerCaseId"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonBlankString"
        },
        "ownerCaseId": {
          "$ref": "#/$defs/nonBlankString"
        },
        "releasedAtMs": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "completedOperation": {
      "allOf": [
        {
          "$ref": "#/$defs/operation"
        },
        {
          "properties": {
            "status": { "enum": ["SUCCEEDED", "FAILED", "TIMED_OUT", "CANCELLED"] }
          }
        },
        {
          "if": {
            "properties": {"status": {"const": "SUCCEEDED"}},
            "required": ["status"]
          },
          "then": {
            "if": {
              "properties": {"type": {"const": "CONTEXT"}},
              "required": ["type"]
            },
            "else": {"required": ["result"]}
          },
          "else": {"required": ["error"]}
        }
      ]
    },
    "retryAttempt": {
      "type": "object",
      "required": [
        "attemptId",
        "requestId",
        "outcome"
      ],
      "properties": {
        "attemptId": {
          "$ref": "#/$defs/nonBlankString"
        },
        "requestId": {
          "$ref": "#/$defs/nonBlankString"
        },
        "outcome": {
          "$ref": "#/$defs/nonBlankString"
        }
      }
    },
    "sideEffect": {
      "type": "object",
      "required": [
        "operationId",
        "count",
        "expectedCount"
      ],
      "properties": {
        "operationId": {
          "$ref": "#/$defs/nonBlankString"
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "expectedCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
