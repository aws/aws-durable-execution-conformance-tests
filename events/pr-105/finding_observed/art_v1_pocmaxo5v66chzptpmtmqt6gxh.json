{"data":{"body":"[P2] Verify envelope ownership rather than only requiring a nonempty value. The three envelopes can contain unrelated or stale `ownerDurableExecutionArn` values and still pass; the verify/output envelopes are never read back to expose this. Bind the current execution ARN into the matcher context and expect it in all three envelopes, with a mismatched-owner negative test.","comment_node_id":"PRRC_kwDOTa1Cx87mb-eX","finding_digest":"7cc88f5c0273902c0cfa610ae752f3b08fab387a4a615f41f1d719853275d3a9","finding_id":"arf_v1_ptei6xacooicydh2mefoouxtwc","finding_key":"test-requirements/serdes/11-1.yaml::expectedexecutionhistory::owner-execution-arn-consistency","identity_key":"test-requirements/serdes/11-1.yaml::expectedexecutionhistory::owner-execution-arn-consistency","line":46,"observation_digest":"220213835ab5d84c20f5418c9d509fd13dfea20c1af69414ce4e9f538caf2e8e","observation_id":"aro_v1_eibbha22wxmeyihviggj2ue72e","path":"packages/aws-durable-execution-conformance-tests/test-requirements/serdes/11-1.yaml","prior_finding_id":"","published_at":"2026-08-26T19:34:55Z","review_id":"arr_v1_3bt4b6ucybnfwx35qp5c6utcpd","reviewed_base_sha":"02d6dca971a38c13d94d6233d12f687e55b2a572","reviewed_head_sha":"44d8b0dc2c6c05eab85d595b699f3dbeb3355bdd","reviewer":"codex","start_line":46,"suggestion_id":""},"pull_request":{"number":105},"record_id":"art_v1_pocmaxo5v66chzptpmtmqt6gxh","record_type":"finding_observed","recorded_at":"2026-08-26T19:34:55Z","repository":{"full_name":"aws/aws-durable-execution-conformance-tests","id":1303200455},"schema_version":1}
