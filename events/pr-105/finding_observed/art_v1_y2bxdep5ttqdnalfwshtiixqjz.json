{"data":{"body":"[P2] Require a structurally valid file-reference envelope. All three regexes merely require these key names somewhere in the payload, so they accept an empty `preview`, metadata outside that object, and even `\"file\": null`. Tighten every matcher to require a non-empty string file reference and scope the metadata to `preview`, or add structural JSON matching for these payloads.","comment_node_id":"PRRC_kwDOTa1Cx87mChmS","finding_digest":"192f48e1a8bf05b7138ddd9d2c13ff294210f9e3a7d3ac8b8f91501446b623cb","finding_id":"arf_v1_dexurynix4c3oe4n3wosye77ff","finding_key":"test-requirements/serdes/11-1.yaml::expected-execution-history::file-reference-envelope-shape","identity_key":"test-requirements/serdes/11-1.yaml::expected-execution-history::file-reference-envelope-shape","line":40,"observation_digest":"c9c9eb31bbb74587fc0cecace9bc5a757ad416323ed724f5ea496539ff068016","observation_id":"aro_v1_zhe6wmn3w5cyp7am5swotpc2ov","path":"packages/aws-durable-execution-conformance-tests/test-requirements/serdes/11-1.yaml","prior_finding_id":"","published_at":"2026-08-26T03:32:03Z","review_id":"arr_v1_pd2wjarkyiv3fttiraoy5gcvoq","reviewed_base_sha":"02d6dca971a38c13d94d6233d12f687e55b2a572","reviewed_head_sha":"5f9cb8ede43545cde9380f54fa613c9f00160bec","reviewer":"codex","start_line":40,"suggestion_id":""},"pull_request":{"number":105},"record_id":"art_v1_y2bxdep5ttqdnalfwshtiixqjz","record_type":"finding_observed","recorded_at":"2026-08-26T03:32:03Z","repository":{"full_name":"aws/aws-durable-execution-conformance-tests","id":1303200455},"schema_version":1}
