{"data":{"body":"[P1] This declares a third publishable distribution, but the workspace and release tooling still enumerate only core and OTel. Consequently the required root test, type, YAML, distribution-build, wheel-smoke, and publication workflows never include Insight, and no release tag can publish it. Register the package throughout the root `pyproject.toml`, distribution scripts, wheel smoke checks, and PyPI release selector, including a gate for the TypeScript examples.","comment_node_id":"PRRC_kwDOTa1Cx87obhAr","finding_digest":"1f8cd11030fd9dd94a2a0f613a77aa6fd80a4315677d6457c7eafd0511b7d1f4","finding_id":"arf_v1_d6gncebq7wo5ssrkb5qtu55kn7","finding_key":"packages/aws-durable-execution-conformance-tests-insight/pyproject.toml::project::workspace-release-registration","identity_key":"packages/aws-durable-execution-conformance-tests-insight/pyproject.toml::project::workspace-release-registration","line":6,"observation_digest":"901daa59fa969bb339fea5f878ef96a9263819278aac7d3c21a6cebbdffb510b","observation_id":"aro_v1_sao2uwp2s2n3gop6ux4hr34wve","path":"packages/aws-durable-execution-conformance-tests-insight/pyproject.toml","prior_finding_id":"","published_at":"2026-08-31T23:57:41Z","review_id":"arr_v1_z35d5antcwg3mnjbcyu24wyhvc","reviewed_base_sha":"b8ca81f11aa28e7f7b77ad96a6d323ce10b5f21f","reviewed_head_sha":"1be134af6fe9773fcafbee1b23c480d1c7e9743e","reviewer":"codex","start_line":6,"suggestion_id":""},"pull_request":{"number":73},"record_id":"art_v1_5nozsmnt3hael2n7u3vcg66gev","record_type":"finding_observed","recorded_at":"2026-08-31T23:57:41Z","repository":{"full_name":"aws/aws-durable-execution-conformance-tests","id":1303200455},"schema_version":1}
