{"data":{"body":"[P1] Returning no errors makes a capability mismatch indistinguishable from successful validation, so the core report records this requirement as `PASSED`; even `--fail-on failed+uncovered` cannot detect it. For example, a CloudWatch run reports every `OPERATIONS_ARRAY` case green without checking any Insight record. Propagate an actual `UNCOVERED` outcome through the hook/report contract, or reject incompatible sink selections until that status is supported, and test the report and exit code.","comment_node_id":"PRRC_kwDOTa1Cx87obg_K","finding_digest":"22aa26ccd4a4d8a9d1523fe5a6c5d12031e90c7eca9e8fb0c8def95db16e70cf","finding_id":"arf_v1_ekvcntguutmktuksh7s2nrorea","finding_key":"packages/aws-durable-execution-conformance-tests-insight/src/aws_durable_execution_conformance_tests_insight/extension.py::validate_insight::capability-mismatch-must-not-pass","identity_key":"packages/aws-durable-execution-conformance-tests-insight/src/aws_durable_execution_conformance_tests_insight/extension.py::validate_insight::capability-mismatch-must-not-pass","line":164,"observation_digest":"03dd1c525fba9189c459d8de7d362da3b168b329dd402e403f040644c7fa6d37","observation_id":"aro_v1_aporyus7xkiytrcz3dph2nrnuo","path":"packages/aws-durable-execution-conformance-tests-insight/src/aws_durable_execution_conformance_tests_insight/extension.py","prior_finding_id":"","published_at":"2026-08-31T23:57:40Z","review_id":"arr_v1_z35d5antcwg3mnjbcyu24wyhvc","reviewed_base_sha":"b8ca81f11aa28e7f7b77ad96a6d323ce10b5f21f","reviewed_head_sha":"1be134af6fe9773fcafbee1b23c480d1c7e9743e","reviewer":"codex","start_line":164,"suggestion_id":""},"pull_request":{"number":73},"record_id":"art_v1_kutwiijybenw37bxjgoqbwyisw","record_type":"finding_observed","recorded_at":"2026-08-31T23:57:40Z","repository":{"full_name":"aws/aws-durable-execution-conformance-tests","id":1303200455},"schema_version":1}
