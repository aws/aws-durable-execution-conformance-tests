{"data":{"body":"[P2] The base `CONTRIBUTING.md` requires SDK-specific handlers and deployment templates to live in their respective SDK repositories, but this PR adds the complete JavaScript implementation here. That couples the language-neutral suite to mutable JavaScript SDK APIs\u2014the installer even clones `main`\u2014and bypasses SDK-owned compatibility testing. Move `examples/typescript` to the JavaScript SDK repository and retain only language-neutral requirements and validation infrastructure here.","comment_node_id":"PRRC_kwDOTa1Cx87obhCW","finding_digest":"c459ebda47b1c88b49b1c1082b0464b7cd1ec16ee5fd78886f7de81d08bae893","finding_id":"arf_v1_yrm6xwshwheiwsnryeecwbdew7","finding_key":"packages/aws-durable-execution-conformance-tests-insight/examples/typescript/template.yaml::typescript-examples::sdk-repository-ownership","identity_key":"packages/aws-durable-execution-conformance-tests-insight/examples/typescript/template.yaml::typescript-examples::sdk-repository-ownership","line":1,"observation_digest":"2930e3ca40ad75535c1f327de20d86a3572442254fca647dd359d721bf62d122","observation_id":"aro_v1_feyohssavv2vgxa7gj66edmgun","path":"packages/aws-durable-execution-conformance-tests-insight/examples/typescript/template.yaml","prior_finding_id":"","published_at":"2026-08-31T23:57:43Z","review_id":"arr_v1_z35d5antcwg3mnjbcyu24wyhvc","reviewed_base_sha":"b8ca81f11aa28e7f7b77ad96a6d323ce10b5f21f","reviewed_head_sha":"1be134af6fe9773fcafbee1b23c480d1c7e9743e","reviewer":"codex","start_line":1,"suggestion_id":""},"pull_request":{"number":73},"record_id":"art_v1_ih2q4754u5it4xlelfunclfkjz","record_type":"finding_observed","recorded_at":"2026-08-31T23:57:43Z","repository":{"full_name":"aws/aws-durable-execution-conformance-tests","id":1303200455},"schema_version":1}
