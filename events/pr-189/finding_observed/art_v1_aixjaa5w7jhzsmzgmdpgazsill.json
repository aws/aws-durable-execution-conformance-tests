{"data":{"body":"[P2] Accept integral JSON numbers for rejection event IDs\n\nThe evidence contract and JSON Schema accept integer-valued numbers such as `99.0`, but this check rejects them. An SDK-owned adapter supplying an otherwise valid `UNDISPATCHED` settlement with that `sourceEventId` fails the coordinator's physical retirement audit and unnecessarily quarantines the target. Use the existing `is_json_integer()` helper and add a regression covering integral floats while continuing to reject booleans and fractional values.","comment_node_id":"PRRC_kwDOTa1Cx88AAAABF3XnWg","finding_digest":"f467aff2c2ef5a05e8c8cdbc1909498faa2893e3ee1d4a00840a55a057d7f1a8","finding_id":"arf_v1_6rt274wc55nal2gizw6bsckjr6","finding_key":"lmi/rules/retirement.py::undispatched_settlements::integral-json-event-id","identity_key":"lmi/rules/retirement.py::undispatched_settlements::integral-json-event-id","line":140,"observation_digest":"9c7afacbac6567e9a192622e8103d6410c775b5e7efad5141b1267d6654a9c20","observation_id":"aro_v1_tr5pvs5mmvt6timsmixica6wie","path":"packages/aws-durable-execution-conformance-tests/src/aws_durable_execution_conformance_tests/lmi/rules/retirement.py","prior_finding_id":"","published_at":"2026-11-25T00:36:40Z","review_id":"arr_v1_ftns5umhf6h7uysn2smqktklbw","reviewed_base_sha":"a2ad1617cafffbbb98248757534a77f87b3ecc37","reviewed_head_sha":"a8dc6107aa3c221409b51e834e47276d429f3ffc","reviewer":"codex","start_line":140,"suggestion_id":"arsg_v1_cuzhsljfihonrvz6axsy4orfwm"},"pull_request":{"number":189},"record_id":"art_v1_aixjaa5w7jhzsmzgmdpgazsill","record_type":"finding_observed","recorded_at":"2026-11-25T00:36:40Z","repository":{"full_name":"aws/aws-durable-execution-conformance-tests","id":1303200455},"schema_version":1}
