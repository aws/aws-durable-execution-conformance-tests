{"data":{"body":"[P2] Honor sequence ordering when task exit and late activity share a timestamp. With `task_exit` at `(60, sequence=10)` and `late_activity` at `(60, sequence=11)`, this comparison accepts the evidence even though activity continued after the recorded exit. Neither common validation nor final retirement rejects that ordering. Use the existing `_at_or_after(exited, late)` helper and add a regression covering equal timestamps with reversed sequences.","comment_node_id":"PRRC_kwDOTa1Cx88AAAABErg8XA","finding_digest":"7d40d55b318429f7b4a3a1219af9348e24d2362f3b0b4d21fab9da30803a5783","finding_id":"arf_v1_pvankwzrqqu7pnfdueqzv6jury","finding_key":"lmi/evidence.py::_evidence.warm_reuse::task-exit-sequence-order","identity_key":"lmi/evidence.py::_evidence.warm_reuse::task-exit-sequence-order","line":864,"observation_digest":"0fa13bf81195f0b8556d10d40ec5ad9ef9f6803ec569232de690892b14bee10e","observation_id":"aro_v1_b6qtx6arsxylqvlncdka5rnnt3","path":"packages/aws-durable-execution-conformance-tests/src/aws_durable_execution_conformance_tests/lmi/evidence.py","prior_finding_id":"","published_at":"2026-11-18T04:00:55Z","review_id":"arr_v1_o2i3zxqed3wpwmrvmb7rn56wpd","reviewed_base_sha":"244a58013ba0216e6e26736b6f7a86164fc9fb83","reviewed_head_sha":"ad071b55084b3cf05c57b1a20ad9282fdc16d186","reviewer":"codex","start_line":862,"suggestion_id":""},"pull_request":{"number":193},"record_id":"art_v1_eysrzcbkbr4no3n3ni4mrfhq7y","record_type":"finding_observed","recorded_at":"2026-11-18T04:00:55Z","repository":{"full_name":"aws/aws-durable-execution-conformance-tests","id":1303200455},"schema_version":1}
