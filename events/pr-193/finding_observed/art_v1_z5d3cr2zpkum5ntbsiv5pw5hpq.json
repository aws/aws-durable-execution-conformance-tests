{"data":{"body":"[P2] Honor sequence ordering when task exit and late activity share a timestamp. Otherwise valid evidence with `task_exit` at `(atMs=60, sequence=10)` and `late_activity` at `(atMs=60, sequence=11)` passes both observation and final validation despite recording activity after task exit. This allows requirement 6 to accept contradictory lifecycle evidence. Use validated per-request sequence values to break timestamp ties and add a regression covering this reversed ordering.","comment_node_id":"PRRC_kwDOTa1Cx88AAAABE1_TPw","finding_digest":"7d40d55b318429f7b4a3a1219af9348e24d2362f3b0b4d21fab9da30803a5783","finding_id":"arf_v1_pvankwzrqqu7pnfdueqzv6jury","finding_key":"lmi/evidence.py::_evidence.warm_reuse::task-exit-sequence-order","identity_key":"lmi/evidence.py::_evidence.warm_reuse::task-exit-sequence-order","line":730,"observation_digest":"081eab94e72ad96771e5e675990cd1b775ab10c32cb07a34cef6c1c13965ca81","observation_id":"aro_v1_bapkxfhhflmwo4pf4z2zsdgrw5","path":"packages/aws-durable-execution-conformance-tests/src/aws_durable_execution_conformance_tests/lmi/evidence.py","prior_finding_id":"arf_v1_pvankwzrqqu7pnfdueqzv6jury","published_at":"2026-11-18T20:02:26Z","review_id":"arr_v1_dtqdtrsrrdxrmzo6dagfxl5ov6","reviewed_base_sha":"244a58013ba0216e6e26736b6f7a86164fc9fb83","reviewed_head_sha":"66e9aa916c2edffa6bb2d7103ca6b1a1db39c422","reviewer":"codex","start_line":728,"suggestion_id":""},"pull_request":{"number":193},"record_id":"art_v1_z5d3cr2zpkum5ntbsiv5pw5hpq","record_type":"finding_observed","recorded_at":"2026-11-18T20:02:26Z","repository":{"full_name":"aws/aws-durable-execution-conformance-tests","id":1303200455},"schema_version":1}
