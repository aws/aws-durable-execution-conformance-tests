{"data":{"body":"[P1] Remove the unsupported `queue` concurrency key. GitHub Actions accepts only `group` and `cancel-in-progress` here, so this causes the reusable workflow to fail validation before any jobs run. Remove it here and from `opentelemetry-long-running.yml`; if preserving multiple pending calls is required, implement queueing outside the concurrency mapping and add workflow-schema lint coverage.","comment_node_id":"PRRC_kwDOTa1Cx876fUlr","finding_digest":"c2e8753aadd7c2a270b4824d00d70545e0d2cce28ef9288d25918681577f721b","finding_id":"arf_v1_yluhkovn27bke4fuqjgqbvyfix","finding_key":"workflows/opentelemetry-suite.yml::concurrency::unsupported-queue-key","identity_key":"workflows/opentelemetry-suite.yml::concurrency::unsupported-queue-key","line":120,"observation_digest":"2b51aa0b84a751533e4e8723e604b579092b3db7c7974c71c55d62fa0aa8d4c7","observation_id":"aro_v1_fni2uc4eu5ivgpsoq4r6mbfvpe","path":".github/workflows/opentelemetry-suite.yml","prior_finding_id":"","published_at":"2026-10-07T02:43:40Z","review_id":"arr_v1_t5itg2goochgkrmn4anahwjvm4","reviewed_base_sha":"3542852f918f515d7c6a53af1eb0d5aa83d1eb1e","reviewed_head_sha":"f5855f2d0f60be996973173cf479c3567f83e30f","reviewer":"codex","start_line":120,"suggestion_id":""},"pull_request":{"number":131},"record_id":"art_v1_sraiiusjxvzvzk3o7orrp7tldg","record_type":"finding_observed","recorded_at":"2026-10-07T02:43:40Z","repository":{"full_name":"aws/aws-durable-execution-conformance-tests","id":1303200455},"schema_version":1}
