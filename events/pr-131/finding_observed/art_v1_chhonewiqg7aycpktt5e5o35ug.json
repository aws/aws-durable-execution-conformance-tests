{"data":{"body":"[P1] Keep fork pull requests on GitHub-hosted runners. This workflow handles `pull_request`, while the called resolver has no fork guard, so this unconditional value routes PR-controlled workflow code onto the CodeBuild runner. The main CI workflow explicitly preserves the opposite trust boundary. Apply the same fork-aware runner expression here; the credentialed suite jobs will retain their existing fork guards.","comment_node_id":"PRRC_kwDOTa1Cx877HwVS","finding_digest":"ecf27f495aa7ed75935e49df3a421c4d0c4537e628d9aaeed7b8946ed08d0616","finding_id":"arf_v1_5tzh6sk2u7wxle26jhptuqq4ju","finding_key":"workflows/opentelemetry-conformance-tests.yml::opentelemetry-runs-on::fork-runner-isolation","identity_key":"workflows/opentelemetry-conformance-tests.yml::opentelemetry-runs-on::fork-runner-isolation","line":79,"observation_digest":"c1d36beb642183a2cd70b1d8cc80ebed40e8a3668f876eb0132cd17c20a7db78","observation_id":"aro_v1_yhjwx23eegb2ftlqwhmmzahl5v","path":".github/workflows/opentelemetry-conformance-tests.yml","prior_finding_id":"","published_at":"2026-10-07T23:37:37Z","review_id":"arr_v1_zfrofnxv3zxlki255pmpvjj7pd","reviewed_base_sha":"bb0c475d6cb238407619f58d5176ed48db7c8ae6","reviewed_head_sha":"176125dbc9f5120c27b39ee2502e56619a60a335","reviewer":"codex","start_line":79,"suggestion_id":"arsg_v1_cnnglpgoacnytggk2qoph64pma"},"pull_request":{"number":131},"record_id":"art_v1_chhonewiqg7aycpktt5e5o35ug","record_type":"finding_observed","recorded_at":"2026-10-07T23:37:37Z","repository":{"full_name":"aws/aws-durable-execution-conformance-tests","id":1303200455},"schema_version":1}
