{"data":{"body":"[P1] Keep polling after the first exact-count match. Telemetry validation currently returns as soon as one collector lookup passes, but S3 exports arrive incrementally. The required eight spans can therefore pass this selector before a later object contributes the replayed duplicate, missing the regression this case targets. Require the candidate to remain valid and unchanged for a quiescence window, and test a duplicate arriving on a subsequent lookup.","comment_node_id":"PRRC_kwDOTa1Cx874mPYV","finding_digest":"5c3824443a7178f83111ce326e3321103135419e5a859d489b9fbc71243f55b0","finding_id":"arf_v1_lq4cirb2of4pqmirzyzg4mzbca","finding_key":"otel-execution-21::completed-step-replay::telemetry-quiescence","identity_key":"otel-execution-21::completed-step-replay::telemetry-quiescence","line":196,"observation_digest":"f83e1e169d2b882e45de16c233e3c6626ba9fe8f9a963f46a0b57cdc3d30b265","observation_id":"aro_v1_7a7b4fu5foec4ro6c3bdhy6gmj","path":"packages/aws-durable-execution-conformance-tests-otel/test-requirements/otel-execution/otel-execution-21.yaml","prior_finding_id":"","published_at":"2026-10-02T23:55:23Z","review_id":"arr_v1_cd55wd4j7ujql6wnxrgelnebs5","reviewed_base_sha":"43872f8d5dd917fe3ee6d01a6c953c1ff67c5fe4","reviewed_head_sha":"922dfafa575f771a6d5b117d9f1e631d149e01e4","reviewer":"codex","start_line":193,"suggestion_id":""},"pull_request":{"number":131},"record_id":"art_v1_aofdvaysbxf5hb4v56yzcxu2ei","record_type":"finding_observed","recorded_at":"2026-10-02T23:55:23Z","repository":{"full_name":"aws/aws-durable-execution-conformance-tests","id":1303200455},"schema_version":1}
