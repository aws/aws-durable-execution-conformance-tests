{"data":{"body":"[P1] This requires an `UNSET` span status even though the instrumentation explicitly identifies the callback operation as `FAILED`. OpenTelemetry's Span Status guidance says instrumentation that knows an operation failed should set `ERROR`; omitting error details does not make the outcome unknown. This rejects SDKs following that guidance. Require `ERROR` in both case-25 views while retaining the `$absent` checks for error payloads.","comment_node_id":"PRRC_kwDOTa1Cx8773hhN","finding_digest":"87e8c578dd350a94c63f48231065ad9a4b22d01bbfd61b165d0aeccd2a77686f","finding_id":"arf_v1_q7umk6g5gufjjrr7jarraznntj","finding_key":"packages/aws-durable-execution-conformance-tests-otel/test-requirements/otel-invocation/otel-invocation-25.yaml::failed-callback-terminal::otel-error-status","identity_key":"packages/aws-durable-execution-conformance-tests-otel/test-requirements/otel-invocation/otel-invocation-25.yaml::failed-callback-terminal::otel-error-status","line":228,"observation_digest":"dff4bea05d61308795a565e537b835f328bcee86968858cfbcf3f8f4ad5e76a0","observation_id":"aro_v1_372l5ic5meyipfnfmxstpobv6m","path":"packages/aws-durable-execution-conformance-tests-otel/test-requirements/otel-invocation/otel-invocation-25.yaml","prior_finding_id":"","published_at":"2026-10-09T00:57:55Z","review_id":"arr_v1_v4c2q7y4dgy3mcp5ulxunjgyta","reviewed_base_sha":"e48ac54502d3c14e2e3fa216c5e200dbb4c14ac2","reviewed_head_sha":"cf325a89d5f1ba3c2d57dbdb71ee6deda778935a","reviewer":"codex","start_line":228,"suggestion_id":""},"pull_request":{"number":131},"record_id":"art_v1_aetjljsrdoax72xk6mpu2ol5lo","record_type":"finding_observed","recorded_at":"2026-10-09T00:57:55Z","repository":{"full_name":"aws/aws-durable-execution-conformance-tests","id":1303200455},"schema_version":1}
