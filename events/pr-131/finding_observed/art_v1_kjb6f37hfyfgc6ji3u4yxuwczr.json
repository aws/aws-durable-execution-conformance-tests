{"data":{"body":"[P1] This callback operation is known to have `FAILED`, so OpenTelemetry requires its Span Status to be `ERROR`; missing error details only affect error attributes. Requiring `UNSET` rejects conformant SDKs. Require `ERROR` here and in execution-view case 25, and update the corresponding tests and documentation while retaining the empty-payload history checks.","comment_node_id":"PRRC_kwDOTa1Cx87736p-","finding_digest":"87e8c578dd350a94c63f48231065ad9a4b22d01bbfd61b165d0aeccd2a77686f","finding_id":"arf_v1_q7umk6g5gufjjrr7jarraznntj","finding_key":"packages/aws-durable-execution-conformance-tests-otel/test-requirements/otel-invocation/otel-invocation-25.yaml::failed-callback-terminal::otel-error-status","identity_key":"packages/aws-durable-execution-conformance-tests-otel/test-requirements/otel-invocation/otel-invocation-25.yaml::failed-callback-terminal::otel-error-status","line":228,"observation_digest":"8a0f28dfbbc8a6a388b19d0cb9a1ba9650301fa0270d457b7259e59c1f09d578","observation_id":"aro_v1_rihsrx53zctkhcfrtugltin2sz","path":"packages/aws-durable-execution-conformance-tests-otel/test-requirements/otel-invocation/otel-invocation-25.yaml","prior_finding_id":"arf_v1_q7umk6g5gufjjrr7jarraznntj","published_at":"2026-10-09T01:19:38Z","review_id":"arr_v1_7ictpx4ize5jrjsh3yenkgmyam","reviewed_base_sha":"e48ac54502d3c14e2e3fa216c5e200dbb4c14ac2","reviewed_head_sha":"75987d46a915bc37409eed3ea9c3617a924c9756","reviewer":"codex","start_line":228,"suggestion_id":""},"pull_request":{"number":131},"record_id":"art_v1_kjb6f37hfyfgc6ji3u4yxuwczr","record_type":"finding_observed","recorded_at":"2026-10-09T01:19:38Z","repository":{"full_name":"aws/aws-durable-execution-conformance-tests","id":1303200455},"schema_version":1}
