{"data":{"body":"[P2] Validate matcher syntax recursively inside every parent branch. This helper only checks top-level controls, so `{\"name\": {\"$any_of\": []}}` is deemed schema-valid; when another alternative matches, the malformed branch's error is discarded and the requirement passes. Apply a generic matcher-schema validator to ordinary properties and `$not`, and add this nested invalid-plus-matching case to the regression test.","comment_node_id":"PRRC_kwDOTa1Cx874nrxk","finding_digest":"0b76f0b8cc2d0938da6a3b0cf08f039fb74236c486185d15e8cf68b74209eb01","finding_id":"arf_v1_bn3pbogmfuetrwtkhmgpbdydt6","finding_key":"validators.py::_parent_expectation_errors::invalid-any-of-alternative-masking","identity_key":"validators.py::_parent_expectation_errors::invalid-any-of-alternative-masking","line":344,"observation_digest":"11be19b159ccd31f93cb934cbb3c9ded7407fe2e16dfb9ec4b91af2a2fc275b1","observation_id":"aro_v1_cg7btmkzztjr7e6lsnglwpe55v","path":"packages/aws-durable-execution-conformance-tests-otel/src/aws_durable_execution_conformance_tests_otel/validators.py","prior_finding_id":"arf_v1_bn3pbogmfuetrwtkhmgpbdydt6","published_at":"2026-10-03T01:39:37Z","review_id":"arr_v1_rop7hwilrwyv5kj3s6g65sbtds","reviewed_base_sha":"43872f8d5dd917fe3ee6d01a6c953c1ff67c5fe4","reviewed_head_sha":"b61f58519418d84d53c5ad26c4aa5821d28b46f7","reviewer":"codex","start_line":337,"suggestion_id":""},"pull_request":{"number":131},"record_id":"art_v1_7a5j7urf2bsmgkwupb77o4exq6","record_type":"finding_observed","recorded_at":"2026-10-03T01:39:37Z","repository":{"full_name":"aws/aws-durable-execution-conformance-tests","id":1303200455},"schema_version":1}
