{"data":{"body":"[P1] Do not treat every non-SDK span as valid ambient Lambda context. A leaked earlier `conformance.*` user span has no durable attributes, so this fallback accepts it; with the 1 ms tolerance, even a just-ended stale span can pass the restoration checks. Add a negative parent predicate for spans carrying `conformance.callback` (or positively identify ambient infrastructure), apply it to every mirrored handler fallback, and add a stale-user-parent test.","comment_node_id":"PRRC_kwDOTa1Cx874mPZy","finding_digest":"a134873a912ff7d980eae15de93034a654299ec30ea37a6624cc9547fb9ff98d","finding_id":"arf_v1_ue2ioourf735tahk4fo6smbuuz","finding_key":"otel-context-22::handler-parent-alternatives::ambient-parent-identity","identity_key":"otel-context-22::handler-parent-alternatives::ambient-parent-identity","line":102,"observation_digest":"d8d82166a5fe5427884882f011afd8c47f6c20cb6d85ed50a207a9e34bbbeca3","observation_id":"aro_v1_3dmcczvf7zkcpcciqlybdl6yyr","path":"packages/aws-durable-execution-conformance-tests-otel/test-requirements/otel-execution/otel-execution-22.yaml","prior_finding_id":"","published_at":"2026-10-02T23:55:24Z","review_id":"arr_v1_cd55wd4j7ujql6wnxrgelnebs5","reviewed_base_sha":"43872f8d5dd917fe3ee6d01a6c953c1ff67c5fe4","reviewed_head_sha":"922dfafa575f771a6d5b117d9f1e631d149e01e4","reviewer":"codex","start_line":100,"suggestion_id":""},"pull_request":{"number":131},"record_id":"art_v1_epialdlmrdsw2cfgtqbro3i6ly","record_type":"finding_observed","recorded_at":"2026-10-02T23:55:24Z","repository":{"full_name":"aws/aws-durable-execution-conformance-tests","id":1303200455},"schema_version":1}
