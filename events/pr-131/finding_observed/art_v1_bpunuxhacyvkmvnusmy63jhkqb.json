{"data":{"body":"[P2] Require exactly two `Invocation` spans. `minimum_invocations` is only a lower bound, and this case omits `require_all_spans`, so `RETRYING`, legacy `RETRY`, and `SUCCEEDED` spans together still pass. Select all execution-correlated `Invocation` spans with `count: 2` and occurrence-specific expectations (or add an exact-count invariant), mirror the fix in the execution-view case, and test an additional unexpected status span.","comment_node_id":"PRRC_kwDOTa1Cx875zDYP","finding_digest":"b03961c19274d52ffc7bf56a00ed18c89ce2255b681575c1770cb2cb89eecdbf","finding_id":"arf_v1_wa4wdqmsotks77d36vvab3iyzc","finding_key":"otel-invocation-24::telemetry-assertions::exact-invocation-count","identity_key":"otel-invocation-24::telemetry-assertions::exact-invocation-count","line":23,"observation_digest":"cd8f957342915ae892b4edf4a220e0dd831c8f3a505bb5e12a75ced69a9d5938","observation_id":"aro_v1_zwhzk42csfnorevu5x2keiha3w","path":"packages/aws-durable-execution-conformance-tests-otel/test-requirements/otel-invocation/otel-invocation-24.yaml","prior_finding_id":"","published_at":"2026-10-06T02:25:49Z","review_id":"arr_v1_ti3wrh3hudrl5uo6mczo352unl","reviewed_base_sha":"3542852f918f515d7c6a53af1eb0d5aa83d1eb1e","reviewed_head_sha":"8d18d7adbe0e9f6dafe3f2b2b88f11f37bad0178","reviewer":"codex","start_line":23,"suggestion_id":""},"pull_request":{"number":131},"record_id":"art_v1_bpunuxhacyvkmvnusmy63jhkqb","record_type":"finding_observed","recorded_at":"2026-10-06T02:25:49Z","repository":{"full_name":"aws/aws-durable-execution-conformance-tests","id":1303200455},"schema_version":1}
