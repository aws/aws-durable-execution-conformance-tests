{"data":{"body":"[P2] If the first history snapshot containing the callback is already terminal and also contains a later `InvocationCompleted`, this condition neither delivers the action nor records it as deferred, so validation can pass with `callbacks_sent == 0`. Treat every still-matching gated action as undelivered at terminal state, or process eligible callbacks before breaking, and add a first-poll terminal regression test.","comment_node_id":"PRRC_kwDOTa1Cx8773wLt","finding_digest":"23c3bfb2e52af1196ae0bb7c85fe09af2d106c74ba91c9541b0a3bda4f6a9966","finding_id":"arf_v1_epb37mxfflyrs2xaxn6il7qjv4","finding_key":"packages/aws-durable-execution-conformance-tests/src/aws_durable_execution_conformance_tests/validate.py::pollingvalidator.validate::terminal-gated-callback-skipped","identity_key":"packages/aws-durable-execution-conformance-tests/src/aws_durable_execution_conformance_tests/validate.py::pollingvalidator.validate::terminal-gated-callback-skipped","line":736,"observation_digest":"684acefb4177c85467dee5630afa83d5cc24ef0b0df5a08f59aaa86022eaace5","observation_id":"aro_v1_nbfm562bo7efiz664vrqv6ud2x","path":"packages/aws-durable-execution-conformance-tests/src/aws_durable_execution_conformance_tests/validate.py","prior_finding_id":"","published_at":"2026-10-09T01:10:22Z","review_id":"arr_v1_dfszjwoc5mfyv3igrvcdnidgwj","reviewed_base_sha":"e48ac54502d3c14e2e3fa216c5e200dbb4c14ac2","reviewed_head_sha":"799c22a0d55ea11dbb9dac098c1f2171eb6c8919","reviewer":"codex","start_line":731,"suggestion_id":""},"pull_request":{"number":131},"record_id":"art_v1_po6f6s6y7deriwckvhrdmwvrp4","record_type":"finding_observed","recorded_at":"2026-10-09T01:10:22Z","repository":{"full_name":"aws/aws-durable-execution-conformance-tests","id":1303200455},"schema_version":1}
