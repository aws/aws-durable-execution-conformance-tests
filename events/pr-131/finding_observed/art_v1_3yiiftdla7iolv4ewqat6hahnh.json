{"data":{"body":"[P1] This requires `UNSET` even though the instrumentation knows the callback operation ended `FAILED`. OpenTelemetry Span Status guidance says known failed operations should use `ERROR`; missing error details only affect error attributes, not the status code. This rejects conformant SDKs. Require `ERROR` here and in execution-view case 25 while retaining the empty-payload history checks.","comment_node_id":"PRRC_kwDOTa1Cx8773wKE","finding_digest":"87e8c578dd350a94c63f48231065ad9a4b22d01bbfd61b165d0aeccd2a77686f","finding_id":"arf_v1_q7umk6g5gufjjrr7jarraznntj","finding_key":"packages/aws-durable-execution-conformance-tests-otel/test-requirements/otel-invocation/otel-invocation-25.yaml::failed-callback-terminal::otel-error-status","identity_key":"packages/aws-durable-execution-conformance-tests-otel/test-requirements/otel-invocation/otel-invocation-25.yaml::failed-callback-terminal::otel-error-status","line":228,"observation_digest":"5e00d8e0442eb04bd12aa589214e358a2d6cd3a121fdb354731190305e4a578a","observation_id":"aro_v1_lyanrycef2yexujkuwesctrvri","path":"packages/aws-durable-execution-conformance-tests-otel/test-requirements/otel-invocation/otel-invocation-25.yaml","prior_finding_id":"arf_v1_q7umk6g5gufjjrr7jarraznntj","published_at":"2026-10-09T01:10:21Z","review_id":"arr_v1_dfszjwoc5mfyv3igrvcdnidgwj","reviewed_base_sha":"e48ac54502d3c14e2e3fa216c5e200dbb4c14ac2","reviewed_head_sha":"799c22a0d55ea11dbb9dac098c1f2171eb6c8919","reviewer":"codex","start_line":228,"suggestion_id":""},"pull_request":{"number":131},"record_id":"art_v1_3yiiftdla7iolv4ewqat6hahnh","record_type":"finding_observed","recorded_at":"2026-10-09T01:10:21Z","repository":{"full_name":"aws/aws-durable-execution-conformance-tests","id":1303200455},"schema_version":1}
