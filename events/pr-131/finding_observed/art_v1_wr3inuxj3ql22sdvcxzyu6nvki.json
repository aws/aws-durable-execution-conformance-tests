{"data":{"body":"[P2] Do not let the existing span-link disparity short-circuit `same_trace_as`. For a selector containing `$linked: true`, X-Ray and Datadog return success before this trace-ID comparison runs, so a user span on another trace can satisfy the assertion. Either reject `$linked` for this relation or skip only the link restriction while still comparing trace IDs, and add a disparity regression test.","comment_node_id":"PRRC_kwDOTa1Cx874nrzo","finding_digest":"223ccbf5e79ddff548c36d658fa6e7c7531dc76de9a8bec6bb9350960f6cae45","finding_id":"arf_v1_ei6mx5phtxp7ksgdnvsy7jxhy5","finding_key":"validators.py::_span_relation_errors::same-trace-link-disparity-bypass","identity_key":"validators.py::_span_relation_errors::same-trace-link-disparity-bypass","line":628,"observation_digest":"0cae72b7e87c5023c1ffa1a945edf2cc0b4c9222e4604685dab22e6af206a394","observation_id":"aro_v1_bsxhfn7iprichqp7uguul3pszq","path":"packages/aws-durable-execution-conformance-tests-otel/src/aws_durable_execution_conformance_tests_otel/validators.py","prior_finding_id":"","published_at":"2026-10-03T01:39:40Z","review_id":"arr_v1_rop7hwilrwyv5kj3s6g65sbtds","reviewed_base_sha":"43872f8d5dd917fe3ee6d01a6c953c1ff67c5fe4","reviewed_head_sha":"b61f58519418d84d53c5ad26c4aa5821d28b46f7","reviewer":"codex","start_line":625,"suggestion_id":""},"pull_request":{"number":131},"record_id":"art_v1_wr3inuxj3ql22sdvcxzyu6nvki","record_type":"finding_observed","recorded_at":"2026-10-03T01:39:40Z","repository":{"full_name":"aws/aws-durable-execution-conformance-tests","id":1303200455},"schema_version":1}
