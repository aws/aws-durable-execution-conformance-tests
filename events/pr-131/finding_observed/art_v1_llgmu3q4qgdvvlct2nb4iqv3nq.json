{"data":{"body":"[P2] Validate every `$any_of` branch before accepting a match. A malformed branch such as `{\"$millisecond_precision\": false}` is currently ignored whenever another alternative matches, so requirement validity depends on the observed trace and an invalid schema can silently pass. Separate recursive shape validation from matching, reject errors from any branch, and add a mixed invalid-plus-matching alternative test.","comment_node_id":"PRRC_kwDOTa1Cx874m4jM","finding_digest":"0b76f0b8cc2d0938da6a3b0cf08f039fb74236c486185d15e8cf68b74209eb01","finding_id":"arf_v1_bn3pbogmfuetrwtkhmgpbdydt6","finding_key":"validators.py::_parent_expectation_errors::invalid-any-of-alternative-masking","identity_key":"validators.py::_parent_expectation_errors::invalid-any-of-alternative-masking","line":349,"observation_digest":"31b94e386fe585d4c6c7301e7e953a60c734d7f5b08a9bcab80518ace4056a7f","observation_id":"aro_v1_gg4u4odp4wc5jrwhgaph5fj2md","path":"packages/aws-durable-execution-conformance-tests-otel/src/aws_durable_execution_conformance_tests_otel/validators.py","prior_finding_id":"","published_at":"2026-10-03T00:37:49Z","review_id":"arr_v1_a7u7zvrjspd3bmhcpsrdtkyx7n","reviewed_base_sha":"43872f8d5dd917fe3ee6d01a6c953c1ff67c5fe4","reviewed_head_sha":"98724ee08b7bd08bf334322e97c4b95e8f61d8bb","reviewer":"codex","start_line":348,"suggestion_id":""},"pull_request":{"number":131},"record_id":"art_v1_llgmu3q4qgdvvlct2nb4iqv3nq","record_type":"finding_observed","recorded_at":"2026-10-03T00:37:49Z","repository":{"full_name":"aws/aws-durable-execution-conformance-tests","id":1303200455},"schema_version":1}
