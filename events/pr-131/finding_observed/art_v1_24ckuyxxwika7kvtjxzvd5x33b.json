{"data":{"body":"[P2] Add explicit first and terminal `Invocation` assertions. `minimum_invocations` deliberately counts duplicate exports, while this case never selects either invocation. On the S3 backend, two copies of the initial `PENDING` span can therefore satisfy this check even when the resumed `SUCCEEDED` invocation is missing. Assert the unique `first: true/PENDING` and `first: false/SUCCEEDED` spans, mirror them in execution case 23, and add a duplicate-initial negative test.","comment_node_id":"PRRC_kwDOTa1Cx874m4gx","finding_digest":"4845d62d0d53938c32b9921008157ab6dfa16a2fbad0b11aa9f752fd9c978b88","finding_id":"arf_v1_jbc5mlinkojyymvzsiiaqfl2w3","finding_key":"otel-invocation-23::telemetry-assertions::distinct-invocation-lifecycle","identity_key":"otel-invocation-23::telemetry-assertions::distinct-invocation-lifecycle","line":19,"observation_digest":"0d153e37f996d6f6424aba026910af7e1c558d5bb335eba22ef86c12674bf10e","observation_id":"aro_v1_bukt4n7zs3lpmqskxibgsefppy","path":"packages/aws-durable-execution-conformance-tests-otel/test-requirements/otel-invocation/otel-invocation-23.yaml","prior_finding_id":"","published_at":"2026-10-03T00:37:47Z","review_id":"arr_v1_a7u7zvrjspd3bmhcpsrdtkyx7n","reviewed_base_sha":"43872f8d5dd917fe3ee6d01a6c953c1ff67c5fe4","reviewed_head_sha":"98724ee08b7bd08bf334322e97c4b95e8f61d8bb","reviewer":"codex","start_line":19,"suggestion_id":""},"pull_request":{"number":131},"record_id":"art_v1_24ckuyxxwika7kvtjxzvd5x33b","record_type":"finding_observed","recorded_at":"2026-10-03T00:37:47Z","repository":{"full_name":"aws/aws-durable-execution-conformance-tests","id":1303200455},"schema_version":1}
