{"data":{"body":"[P1] This marker is emitted only during replay, but replay-aware loggers normally suppress replay output unless explicitly enabled. An SDK that executes the step body before detecting the mismatch could therefore still produce zero records and pass. Require replay logging explicitly, ideally with a positive canary log proving collection works.","comment_node_id":"PRRC_kwDOTa1Cx87ogM8H","finding_digest":"b36479ad45aba80f4d965a284b4d02348403ffa294fe3d2d55726efe8433fd98","finding_id":"arf_v1_wnshtlkfvoua6tmwliuewticgs","finding_key":"test-requirements/determinism/11-1.yaml::handler::replay-body-marker-observability","identity_key":"test-requirements/determinism/11-1.yaml::handler::replay-body-marker-observability","line":11,"observation_digest":"447180dd6b222d5f4315f344df9b8d5342e95cf4705e15148e5a06fa32845427","observation_id":"aro_v1_iryybxlleiwv6qyv6ncn7g4nkn","path":"packages/aws-durable-execution-conformance-tests/test-requirements/determinism/11-1.yaml","prior_finding_id":"","published_at":"2026-09-01T04:23:33Z","review_id":"arr_v1_ezrkz7m2r7pdcm666gin4o4c7z","reviewed_base_sha":"b8ca81f11aa28e7f7b77ad96a6d323ce10b5f21f","reviewed_head_sha":"dacafe87f9a5b0b488da839547ba75d6fd8d6d31","reviewer":"codex","start_line":9,"suggestion_id":"arsg_v1_ser5nuiw7yei5p7yqsacdomt2c"},"pull_request":{"number":111},"record_id":"art_v1_aj4mjnk7prwbyersgx5vo3tqmo","record_type":"finding_observed","recorded_at":"2026-09-01T04:23:33Z","repository":{"full_name":"aws/aws-durable-execution-conformance-tests","id":1303200455},"schema_version":1}
