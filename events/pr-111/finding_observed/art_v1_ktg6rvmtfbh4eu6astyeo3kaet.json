{"data":{"body":"[P2] Using `get(\"Error\")` erases whether the service returned the field. Consequently top-level expectations such as `Error: '*'`, `Error: {}`, `Error: ${ERR}`, or `Error: null` can pass when `Error` is absent, unlike nested history matching which reports a missing key. Check for `\"Error\" in execution` before matching and add a missing-field test.","comment_node_id":"PRRC_kwDOTa1Cx87ogM_M","finding_digest":"13ab5a9ed0a99166e6748a50392673abddef4a00277d5d99f8e091f52507c4ed","finding_id":"arf_v1_covvvhwqvgiwnzturjidsjttvp","finding_key":"validate.py::_validate_execution_result::error-field-presence","identity_key":"validate.py::_validate_execution_result::error-field-presence","line":511,"observation_digest":"6e3152998a10b9210ee0725ab6bc4902930d8912f274e394a131ce6654b5f9c3","observation_id":"aro_v1_nyyvfgmkcc4scdxaojnlnpcjak","path":"packages/aws-durable-execution-conformance-tests/src/aws_durable_execution_conformance_tests/validate.py","prior_finding_id":"","published_at":"2026-09-01T04:23:36Z","review_id":"arr_v1_ezrkz7m2r7pdcm666gin4o4c7z","reviewed_base_sha":"b8ca81f11aa28e7f7b77ad96a6d323ce10b5f21f","reviewed_head_sha":"dacafe87f9a5b0b488da839547ba75d6fd8d6d31","reviewer":"codex","start_line":511,"suggestion_id":""},"pull_request":{"number":111},"record_id":"art_v1_ktg6rvmtfbh4eu6astyeo3kaet","record_type":"finding_observed","recorded_at":"2026-09-01T04:23:36Z","repository":{"full_name":"aws/aws-durable-execution-conformance-tests","id":1303200455},"schema_version":1}
