{"data":{"body":"[P1] This regex only proves that both operation tokens occur, so a reversed diagnostic such as `expected STEP, got WAIT` passes. It also unnecessarily requires \u201cnon-determin\u201d in the message even though `ErrorType` already establishes that category. Update both message assertions to associate WAIT with expected and STEP with actual/current, preferably through structured fields if available.","comment_node_id":"PRRC_kwDOTa1Cx87ogM9k","finding_digest":"fe2053ad9827d67f269c4116aed500d52a86819c68030cb9abd8748ff5caf09c","finding_id":"arf_v1_7yqfhlmye7lh6ju4ielk5via2u","finding_key":"test-requirements/determinism/11-1.yaml::error-assertions::operation-role-contract","identity_key":"test-requirements/determinism/11-1.yaml::error-assertions::operation-role-contract","line":27,"observation_digest":"0be039f47ae362cc6b3fb8bd708331c8ac544cebb4f0c15bbb55cc4921eb01d0","observation_id":"aro_v1_bpqdt5d24nrmy2z7xc6xbazrzc","path":"packages/aws-durable-execution-conformance-tests/test-requirements/determinism/11-1.yaml","prior_finding_id":"","published_at":"2026-09-01T04:23:35Z","review_id":"arr_v1_ezrkz7m2r7pdcm666gin4o4c7z","reviewed_base_sha":"b8ca81f11aa28e7f7b77ad96a6d323ce10b5f21f","reviewed_head_sha":"dacafe87f9a5b0b488da839547ba75d6fd8d6d31","reviewer":"codex","start_line":27,"suggestion_id":""},"pull_request":{"number":111},"record_id":"art_v1_edxy2e7bobzejgbd2ybbdbqbuc","record_type":"finding_observed","recorded_at":"2026-09-01T04:23:35Z","repository":{"full_name":"aws/aws-durable-execution-conformance-tests","id":1303200455},"schema_version":1}
