{"data":{"body":"[P2] Make artifact names unique per reusable-workflow invocation. If a caller invokes this workflow twice in one run\u2014for different runtimes or regions\u2014both harness jobs upload `lmi-harness-tests`. The pinned upload action rejects duplicate names, failing one harness and skipping its dependent cloud job. Include an invocation-specific prefix or stack/region/runtime identifiers in both upload names; the cloud name also collides for same-runtime calls.","comment_node_id":"PRRC_kwDOTa1Cx88AAAABEcZtKw","finding_digest":"fa866b2438a62d7e7c894b4f45b0ec290413de5b65623293929549560cd2960a","finding_id":"arf_v1_7kdgwjbyuywx47ejjnhulmhmfe","finding_key":"github/workflows/lmi-lifecycle.yml::harness-artifacts::unique-reusable-invocation-names","identity_key":"github/workflows/lmi-lifecycle.yml::harness-artifacts::unique-reusable-invocation-names","line":82,"observation_digest":"af90b05f3cb64bc4cbba6f657dc9082501f877d899cd30ba0920e8db54c8c155","observation_id":"aro_v1_v6ilaxz4wzf4js52n5sx3siieu","path":".github/workflows/lmi-lifecycle.yml","prior_finding_id":"arf_v1_7kdgwjbyuywx47ejjnhulmhmfe","published_at":"2026-11-16T23:34:10Z","review_id":"arr_v1_vrqlysqrhwhzoevgiswz4qbiqw","reviewed_base_sha":"cdf6fa1ddd0871f299386c172bf911757f490b18","reviewed_head_sha":"a808cbb1d1121619ba0c4dea7e301ccda558416d","reviewer":"codex","start_line":82,"suggestion_id":""},"pull_request":{"number":190},"record_id":"art_v1_nz3pmikcagcbq434cyccsddj73","record_type":"finding_observed","recorded_at":"2026-11-16T23:34:10Z","repository":{"full_name":"aws/aws-durable-execution-conformance-tests","id":1303200455},"schema_version":1}
