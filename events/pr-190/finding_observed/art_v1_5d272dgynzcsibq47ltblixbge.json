{"data":{"body":"[P2] Make artifact names unique per reusable-workflow invocation. If a caller invokes this workflow twice in one run\u2014for example, for different runtimes or regions\u2014both harness jobs upload `lmi-harness-tests`. The pinned upload action rejects duplicate artifact names, failing one harness and skipping its dependent cloud job. Include an invocation-specific prefix or stack/region/runtime identifiers in both upload names; the cloud name also collides for same-runtime calls.","comment_node_id":"PRRC_kwDOTa1Cx88AAAABEcQ-Ug","finding_digest":"fa866b2438a62d7e7c894b4f45b0ec290413de5b65623293929549560cd2960a","finding_id":"arf_v1_7kdgwjbyuywx47ejjnhulmhmfe","finding_key":"github/workflows/lmi-lifecycle.yml::harness-artifacts::unique-reusable-invocation-names","identity_key":"github/workflows/lmi-lifecycle.yml::harness-artifacts::unique-reusable-invocation-names","line":83,"observation_digest":"cbd9576eda266a9beb4068accc1c7c665c40f5ccca016930d3d10865ee000f75","observation_id":"aro_v1_zpmvo3w2ezvjx22ancwmyhd4mz","path":".github/workflows/lmi-lifecycle.yml","prior_finding_id":"","published_at":"2026-11-16T23:19:44Z","review_id":"arr_v1_y5skiowtehwrvhf574vcwzfrb2","reviewed_base_sha":"90c5b1b976fddcc87ee914d615adca6b7d2950dd","reviewed_head_sha":"803032326bb7930620e53285fe40602c7bd62020","reviewer":"codex","start_line":79,"suggestion_id":""},"pull_request":{"number":190},"record_id":"art_v1_5d272dgynzcsibq47ltblixbge","record_type":"finding_observed","recorded_at":"2026-11-16T23:19:44Z","repository":{"full_name":"aws/aws-durable-execution-conformance-tests","id":1303200455},"schema_version":1}
