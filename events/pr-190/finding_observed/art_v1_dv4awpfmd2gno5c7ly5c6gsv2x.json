{"data":{"body":"[P2] Include every required behavior budget in this example. `load_manifest` rejects the documented two-field object: `deadline-during-step` also requires `observationGraceMs`, while `peer-recovery` requires both `observationGraceMs` and `recoveryMs`. Following this guidance therefore fails validation before execution or evidence reporting. Show complete budget objects matching each requirement's `behaviorBudgets`, and retain the same complete objects in the evidence.","comment_node_id":"PRRC_kwDOTa1Cx88AAAABEcQ_aA","finding_digest":"704165e6df336ef4e58ee1b96cfe24fd817ec30e87646bb15547bc741e7a4181","finding_id":"arf_v1_obawlzw7gnxpjzmo4g4wz7re7w","finding_key":"lmi/readme.md::behavior-budgets-example::complete-required-budget-fields","identity_key":"lmi/readme.md::behavior-budgets-example::complete-required-budget-fields","line":130,"observation_digest":"85960b5f0c322a48a749bc1649466c88f9258c698c73b2e91f15d171e6cfc275","observation_id":"aro_v1_qwlawxymgiverj2jxqlesrtmrd","path":"packages/aws-durable-execution-conformance-tests/src/aws_durable_execution_conformance_tests/lmi/README.md","prior_finding_id":"","published_at":"2026-11-16T23:19:45Z","review_id":"arr_v1_y5skiowtehwrvhf574vcwzfrb2","reviewed_base_sha":"90c5b1b976fddcc87ee914d615adca6b7d2950dd","reviewed_head_sha":"803032326bb7930620e53285fe40602c7bd62020","reviewer":"codex","start_line":126,"suggestion_id":""},"pull_request":{"number":190},"record_id":"art_v1_dv4awpfmd2gno5c7ly5c6gsv2x","record_type":"finding_observed","recorded_at":"2026-11-16T23:19:45Z","repository":{"full_name":"aws/aws-durable-execution-conformance-tests","id":1303200455},"schema_version":1}
