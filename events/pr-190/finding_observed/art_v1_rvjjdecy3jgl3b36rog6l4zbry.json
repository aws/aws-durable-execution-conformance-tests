{"data":{"body":"[P1] Keep Dependabot pushes on the unprivileged runner. When a caller runs on `push` with `github.actor == 'dependabot[bot]'`, the leading pull-request condition is false, so this selects CodeBuild and executes dependency installation and SDK tests inside the testing account. The cloud job's separate Dependabot exclusion does not protect the harness. Move the Dependabot check outside the pull-request condition and test this event/actor combination.","comment_node_id":"PRRC_kwDOTa1Cx88AAAABEcZr-Q","finding_digest":"3825960b5c263441b46b2928ab7fa983278090ee777fd5652c578351e65d8300","finding_id":"arf_v1_haszmc24ey2edndlfeukw75jqm","finding_key":"github/workflows/lmi-lifecycle.yml::harness-runs-on::dependabot-runner-isolation","identity_key":"github/workflows/lmi-lifecycle.yml::harness-runs-on::dependabot-runner-isolation","line":55,"observation_digest":"e70582f6e5d996572e384e4e3ecc77b228a227670e1c1b875e6d804641c62260","observation_id":"aro_v1_44cyf5xf3glfolryjzhd5tdxwi","path":".github/workflows/lmi-lifecycle.yml","prior_finding_id":"","published_at":"2026-11-16T23:34:09Z","review_id":"arr_v1_vrqlysqrhwhzoevgiswz4qbiqw","reviewed_base_sha":"cdf6fa1ddd0871f299386c172bf911757f490b18","reviewed_head_sha":"a808cbb1d1121619ba0c4dea7e301ccda558416d","reviewer":"codex","start_line":55,"suggestion_id":"arsg_v1_ntavz6vrlxlnfnuglrdeokes5x"},"pull_request":{"number":190},"record_id":"art_v1_rvjjdecy3jgl3b36rog6l4zbry","record_type":"finding_observed","recorded_at":"2026-11-16T23:34:09Z","repository":{"full_name":"aws/aws-durable-execution-conformance-tests","id":1303200455},"schema_version":1}
