{"data":{"body":"[P2] Accept supported active statuses for deadline victims\n\nA victim independently proven paused at the behavior cutoff is normalized to `PAUSED` by `_active_status_at_cutoff`, and its later stop can establish complete history coverage. This expectation nevertheless excludes `PAUSED`, so an otherwise valid deadline or peer-recovery case fails the status assertion. Include the supported active cutoff statuses in this oracle and add an adjudication regression using the binding-derived expectation with a paused victim.","comment_node_id":"","finding_digest":"b7d234ab85771f7d7d347618ebca7e2bfee40eb8a2b7aa51942b6864325b5cce","finding_id":"arf_v1_w7jdjk4fo4px27juoymoxst6fp","finding_key":"lmi/source_evidence.py::_binding_expected_outcome::active-cutoff-status-coverage","identity_key":"lmi/source_evidence.py::_binding_expected_outcome::active-cutoff-status-coverage","line":1540,"observation_digest":"427b26325b6127e465a5030d60db7c6d8d69cda2ef35ef45dc09559d3adc8564","observation_id":"aro_v1_ij5smms3met6iznfamgwbw34nw","path":"packages/aws-durable-execution-conformance-tests/src/aws_durable_execution_conformance_tests/lmi/source_evidence.py","prior_finding_id":"arf_v1_w7jdjk4fo4px27juoymoxst6fp","published_at":"2026-11-25T23:50:21Z","review_id":"arr_v1_33tacchfzaek36m7gblwbldxc7","reviewed_base_sha":"6c6ba2d8158c162603b8eec735f592d65faf6a5d","reviewed_head_sha":"e0ed82d9c6d7496b2a86ea8f9c0bdc4395dad88e","reviewer":"codex","start_line":1540,"suggestion_id":"","suppressed":true,"suppression_status":"deferred"},"pull_request":{"number":220},"record_id":"art_v1_ejmndl6krtbdlhuhhrvf5oxei3","record_type":"finding_observed","recorded_at":"2026-11-25T23:50:21Z","repository":{"full_name":"aws/aws-durable-execution-conformance-tests","id":1303200455},"schema_version":1}
