{"data":{"body":"[P2] Accept supported active statuses for deadline victims\n\nA victim independently proven paused at the behavior cutoff is normalized to `PAUSED` by `_active_status_at_cutoff`, and its later stop can establish complete history coverage. This expectation nevertheless excludes `PAUSED`, so an otherwise valid deadline or peer-recovery case fails the status assertion. Include the supported active cutoff statuses and add an adjudication regression using the binding-derived expectation with a paused victim.","comment_node_id":"","finding_digest":"b7d234ab85771f7d7d347618ebca7e2bfee40eb8a2b7aa51942b6864325b5cce","finding_id":"arf_v1_w7jdjk4fo4px27juoymoxst6fp","finding_key":"lmi/source_evidence.py::_binding_expected_outcome::active-cutoff-status-coverage","identity_key":"lmi/source_evidence.py::_binding_expected_outcome::active-cutoff-status-coverage","line":1540,"observation_digest":"a28eb712070be1928ca8252bc28b8ed4326f46bb365ff47c87a46f46c1cd1f5a","observation_id":"aro_v1_ukhloeqhbpqzfdfieuv4fc4o2q","path":"packages/aws-durable-execution-conformance-tests/src/aws_durable_execution_conformance_tests/lmi/source_evidence.py","prior_finding_id":"arf_v1_w7jdjk4fo4px27juoymoxst6fp","published_at":"2026-11-26T18:42:49Z","review_id":"arr_v1_mzj6jhsvfzfe3k2cdnkw5qxuop","reviewed_base_sha":"6c6ba2d8158c162603b8eec735f592d65faf6a5d","reviewed_head_sha":"73188c38d4a4a6f89e543b2dd86630341675bc58","reviewer":"codex","start_line":1540,"suggestion_id":"","suppressed":true,"suppression_status":"deferred"},"pull_request":{"number":220},"record_id":"art_v1_tui5ydbpc3xas2ytrn6oux3qrq","record_type":"finding_observed","recorded_at":"2026-11-26T18:42:49Z","repository":{"full_name":"aws/aws-durable-execution-conformance-tests","id":1303200455},"schema_version":1}
