{"data":{"body":"[P2] Distinguish missing history fields from JSON null\n\nAn expected JSON `null` matches an absent service-history field because `.get()` supplies `None`. A `SUCCEEDED` expectation with `result: null` therefore passes when the collected history omits `result`, accepting missing output as conformance evidence. Require every expected field except `allowedStatuses` to exist before comparing its value, and add a null-versus-missing regression test.","comment_node_id":"PRRC_kwDOTa1Cx88AAAABEcaupQ","finding_digest":"19ec90bb2a105c75c8a1a31e44f46d4268cb1cb2707e1fd75be66742d3b30c48","finding_id":"arf_v1_dhwjbozkcbohlsfbumpej5dnij","finding_key":"lmi/evidence.py::_evidence.histories::expected-field-presence","identity_key":"lmi/evidence.py::_evidence.histories::expected-field-presence","line":269,"observation_digest":"fa9f7b40d7c06eca8f6b45c50d3d014d910e51932c01328a0647e248edca33e9","observation_id":"aro_v1_7kpxwqgxybxmvd3lixcq2pibjw","path":"packages/aws-durable-execution-conformance-tests/src/aws_durable_execution_conformance_tests/lmi/evidence.py","prior_finding_id":"","published_at":"2026-11-16T23:35:54Z","review_id":"arr_v1_clb3yysyrlifzq4looynkpu7vw","reviewed_base_sha":"30915949a9f08023f6227357338d3a7cf1495313","reviewed_head_sha":"b6ff5728df3290f7311901140ffd5aa682d0df72","reviewer":"codex","start_line":269,"suggestion_id":"arsg_v1_654kudwtadxxpwof4wlatwx3y7"},"pull_request":{"number":187},"record_id":"art_v1_ns2t5lazdgpomkit4b3ux2w55q","record_type":"finding_observed","recorded_at":"2026-11-16T23:35:54Z","repository":{"full_name":"aws/aws-durable-execution-conformance-tests","id":1303200455},"schema_version":1}
