{"data":{"body":"[P2] Validate supplied fault-release timestamps before comparing them\n\nA supplied `faultsCreated[].releasedAtMs` such as `\"34\"` or NaN silently bypasses this check and the equivalent recovery check. Otherwise valid evidence with a later numeric retirement release passes both phases despite an unusable observed release time. Validate every supplied release timestamp as finite and nonnegative before applying ordering checks, and add malformed-value tests for both phases.","comment_node_id":"PRRC_kwDOTa1Cx88AAAABEcwwUA","finding_digest":"28999b974925ef41b30113c80137169c5a925490ef46a352e35a66c0c3361c25","finding_id":"arf_v1_fcmzxf2jexxudmybcpeacnywtr","finding_key":"lmi/evidence.py::_evidence.deadline::supplied-fault-release-time-validation","identity_key":"lmi/evidence.py::_evidence.deadline::supplied-fault-release-time-validation","line":403,"observation_digest":"de74fd0043aef061c7465eb869e6674848992d5566965ab218a366bd21f617d7","observation_id":"aro_v1_3z2p2acdv3ygdr2gl24gtzthjb","path":"packages/aws-durable-execution-conformance-tests/src/aws_durable_execution_conformance_tests/lmi/evidence.py","prior_finding_id":"","published_at":"2026-11-17T00:20:47Z","review_id":"arr_v1_suiaimeqnsnzxykvbltjf63m4q","reviewed_base_sha":"30915949a9f08023f6227357338d3a7cf1495313","reviewed_head_sha":"de983566a13b8e6606398d9a461ae6393ffcce73","reviewer":"codex","start_line":400,"suggestion_id":""},"pull_request":{"number":187},"record_id":"art_v1_fjtamu4lbxdk46vsrue5xb3tqv","record_type":"finding_observed","recorded_at":"2026-11-17T00:20:47Z","repository":{"full_name":"aws/aws-durable-execution-conformance-tests","id":1303200455},"schema_version":1}
