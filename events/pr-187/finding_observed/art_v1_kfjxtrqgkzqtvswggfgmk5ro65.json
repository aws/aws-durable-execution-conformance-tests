{"data":{"body":"[P2] Check recovery execution identity against every selected peer\n\nFor native concurrency three or higher, this excludes only the primary `peer`. Recovery can reuse `peer2`'s execution ARN, with consistently attributed events and history, and still pass as an independent recovery request. Compare against the victim and every selected `peer*` execution ARN, and add a multi-peer regression test.","comment_node_id":"PRRC_kwDOTa1Cx88AAAABEczobg","finding_digest":"5e2c3abff3dbb56714d3db724412f914d3f9188729f75b966040f0ac2f123c89","finding_id":"arf_v1_lywdvp7t3o2wofgt3nzeiexzct","finding_key":"lmi/evidence.py::_evidence.recovery::recovery-execution-excludes-all-peers","identity_key":"lmi/evidence.py::_evidence.recovery::recovery-execution-excludes-all-peers","line":429,"observation_digest":"533cf006bd4a70a0ed23d5c82cbbcbc441018100a9e0bf1b8e2eff2e66720720","observation_id":"aro_v1_km6pabv5jjykb3jd2xeczo6lyr","path":"packages/aws-durable-execution-conformance-tests/src/aws_durable_execution_conformance_tests/lmi/evidence.py","prior_finding_id":"arf_v1_lywdvp7t3o2wofgt3nzeiexzct","published_at":"2026-11-17T00:26:36Z","review_id":"arr_v1_t6qy37zgqst2aw3m3beaybxkmw","reviewed_base_sha":"30915949a9f08023f6227357338d3a7cf1495313","reviewed_head_sha":"53d8ec2a9dab1774b9df0a5b0b112502a460d476","reviewer":"codex","start_line":428,"suggestion_id":""},"pull_request":{"number":187},"record_id":"art_v1_kfjxtrqgkzqtvswggfgmk5ro65","record_type":"finding_observed","recorded_at":"2026-11-17T00:26:36Z","repository":{"full_name":"aws/aws-durable-execution-conformance-tests","id":1303200455},"schema_version":1}
