{"data":{"body":"[P2] Check recovery execution identity against every selected peer\n\nFor native concurrency three or higher, this excludes only the primary `peer`. Recovery can reuse `peer2`'s execution ARN, with consistently attributed events and history, and still pass as an independent recovery request. Compare against the victim and every selected `peer*` execution ARN, and add a multi-peer regression test.","comment_node_id":"PRRC_kwDOTa1Cx88AAAABEcwxGg","finding_digest":"5e2c3abff3dbb56714d3db724412f914d3f9188729f75b966040f0ac2f123c89","finding_id":"arf_v1_lywdvp7t3o2wofgt3nzeiexzct","finding_key":"lmi/evidence.py::_evidence.recovery::recovery-execution-excludes-all-peers","identity_key":"lmi/evidence.py::_evidence.recovery::recovery-execution-excludes-all-peers","line":429,"observation_digest":"0b6c1e97bf28e2d96834deffae61b89ef850f154f72cc78d3df6bc56a9b549d8","observation_id":"aro_v1_bnwb5f57fdrns2bu33724ynyt3","path":"packages/aws-durable-execution-conformance-tests/src/aws_durable_execution_conformance_tests/lmi/evidence.py","prior_finding_id":"","published_at":"2026-11-17T00:20:48Z","review_id":"arr_v1_suiaimeqnsnzxykvbltjf63m4q","reviewed_base_sha":"30915949a9f08023f6227357338d3a7cf1495313","reviewed_head_sha":"de983566a13b8e6606398d9a461ae6393ffcce73","reviewer":"codex","start_line":428,"suggestion_id":""},"pull_request":{"number":187},"record_id":"art_v1_otwhmmuexb4qhqq5sn5bc37ea3","record_type":"finding_observed","recorded_at":"2026-11-17T00:20:48Z","repository":{"full_name":"aws/aws-durable-execution-conformance-tests","id":1303200455},"schema_version":1}
