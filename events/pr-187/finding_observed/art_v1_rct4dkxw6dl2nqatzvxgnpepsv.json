{"data":{"body":"[P3] Make console gap labels respect the strict policy\n\nLMI manifests containing `not_implemented` cases now exit with code 1, but `render_console()` still labels those results `Not implemented (declared SDK gap, non-blocking)`. This contradicts the new policy and misleads users interpreting a failed run. Make the label depend on `report.blocking_statuses()` or remove the unconditional qualifier, and cover strict and default console output in tests.","comment_node_id":"PRRC_kwDOTa1Cx88AAAABEeCGng","finding_digest":"7051d4f29cb2d477ebdb6198d4974912ffc4e44653ba2ad5e1184c41948f030d","finding_id":"arf_v1_obi5j4u4wlkhp263mgmnjf2jcl","finding_key":"report.py::fail_on_strict::console-blocking-status-consistency","identity_key":"report.py::fail_on_strict::console-blocking-status-consistency","line":46,"observation_digest":"c8681486534af7ddba773453cd3d6594f35bd3dd898539cacf647c9fc06bef7e","observation_id":"aro_v1_zbubjbstjl353otxgrj42plfst","path":"packages/aws-durable-execution-conformance-tests/src/aws_durable_execution_conformance_tests/report.py","prior_finding_id":"","published_at":"2026-11-17T03:25:10Z","review_id":"arr_v1_uoh3xouzs237yubgv4mubobk37","reviewed_base_sha":"30915949a9f08023f6227357338d3a7cf1495313","reviewed_head_sha":"1c73b4766308155c02ed5c28de8a5df63dd04e31","reviewer":"codex","start_line":46,"suggestion_id":""},"pull_request":{"number":187},"record_id":"art_v1_rct4dkxw6dl2nqatzvxgnpepsv","record_type":"finding_observed","recorded_at":"2026-11-17T03:25:10Z","repository":{"full_name":"aws/aws-durable-execution-conformance-tests","id":1303200455},"schema_version":1}
