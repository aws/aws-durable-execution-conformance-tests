{"data":{"body":"[P2] Validate supplied fault-release timestamps before comparing them\n\nA supplied `faultsCreated[].releasedAtMs` such as `\"34\"` or NaN silently bypasses this check and the equivalent recovery check. Otherwise valid evidence with a later numeric retirement release passes both validation phases despite an unusable observed release time. Validate every supplied release timestamp as finite and nonnegative before applying ordering checks, and add malformed-value tests for both phases.","comment_node_id":"PRRC_kwDOTa1Cx88AAAABEczpag","finding_digest":"28999b974925ef41b30113c80137169c5a925490ef46a352e35a66c0c3361c25","finding_id":"arf_v1_fcmzxf2jexxudmybcpeacnywtr","finding_key":"lmi/evidence.py::_evidence.deadline::supplied-fault-release-time-validation","identity_key":"lmi/evidence.py::_evidence.deadline::supplied-fault-release-time-validation","line":403,"observation_digest":"4825b154f2d13f5d4d16e163ee22d601479c59c5a0396b62d5f654d7737b246e","observation_id":"aro_v1_jas3cvhs2e7v2tiw4fr64iwwaf","path":"packages/aws-durable-execution-conformance-tests/src/aws_durable_execution_conformance_tests/lmi/evidence.py","prior_finding_id":"arf_v1_fcmzxf2jexxudmybcpeacnywtr","published_at":"2026-11-17T00:26:38Z","review_id":"arr_v1_t6qy37zgqst2aw3m3beaybxkmw","reviewed_base_sha":"30915949a9f08023f6227357338d3a7cf1495313","reviewed_head_sha":"53d8ec2a9dab1774b9df0a5b0b112502a460d476","reviewer":"codex","start_line":400,"suggestion_id":""},"pull_request":{"number":187},"record_id":"art_v1_7xq6sdeh7mvzupxmauv5bwnfg5","record_type":"finding_observed","recorded_at":"2026-11-17T00:26:38Z","repository":{"full_name":"aws/aws-durable-execution-conformance-tests","id":1303200455},"schema_version":1}
