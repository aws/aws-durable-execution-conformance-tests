{"data":{"body":"[P2] Permit the documented empty NOT_IMPLEMENTED reason\n\nCONTRIBUTING.md explicitly allows an empty reason for a self-explanatory missing handler. An otherwise valid scenario with `\"not_implemented\": \"\"` instead aborts manifest loading before any reports are produced. Accept an empty string and add a CLI regression confirming that the gap produces a `NOT_IMPLEMENTED` report entry and strict exit code 1.","comment_node_id":"PRRC_kwDOTa1Cx88AAAABEcwxxQ","finding_digest":"c7a2e50308da73d1d8e3b3739393026045cf5b1739d2966e27a791bdfc75c7aa","finding_id":"arf_v1_y6rokayi3jz5dwhdwnzzheycmb","finding_key":"lmi/app.py::load_manifest::reasonless-not-implemented-reporting","identity_key":"lmi/app.py::load_manifest::reasonless-not-implemented-reporting","line":239,"observation_digest":"fa274536e7967829f0963ff3d4cb76eefc423b549854ae6881624ffe414312c9","observation_id":"aro_v1_7ituknxhsz4ct4ewh7z5js3w53","path":"packages/aws-durable-execution-conformance-tests/src/aws_durable_execution_conformance_tests/lmi/app.py","prior_finding_id":"","published_at":"2026-11-17T00:20:50Z","review_id":"arr_v1_suiaimeqnsnzxykvbltjf63m4q","reviewed_base_sha":"30915949a9f08023f6227357338d3a7cf1495313","reviewed_head_sha":"de983566a13b8e6606398d9a461ae6393ffcce73","reviewer":"codex","start_line":236,"suggestion_id":"arsg_v1_okteto4v23obdfceztwjata45z"},"pull_request":{"number":187},"record_id":"art_v1_euhfazoyfd75shogbvvuzjfnow","record_type":"finding_observed","recorded_at":"2026-11-17T00:20:50Z","repository":{"full_name":"aws/aws-durable-execution-conformance-tests","id":1303200455},"schema_version":1}
