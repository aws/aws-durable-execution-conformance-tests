{"data":{"body":"[P2] Preserve the admitted coverage profile in invocation payloads\n\nFor a caller-owned `SuiteDefinition`, `ScenarioContext.dispatcher()` supplies the selected coverage profile, but this assignment overwrites it with `standard`. SDK fixtures dispatching on that field therefore execute the wrong suite while retained evidence still identifies the caller-owned profile. Forward the context's profile and test a nonstandard suite through `Cloud.start()`.","comment_node_id":"PRRC_kwDOTa1Cx88AAAABEaznxA","finding_digest":"e8fc939d82fd630079c90b71dd59c22b13a7aabae7cc307b722ab0b47ff98a80","finding_id":"arf_v1_5d6jhhmc7vrqa6ojbny52wocfm","finding_key":"lmi/cloud.py::cloud.start::coverage-profile-preservation","identity_key":"lmi/cloud.py::cloud.start::coverage-profile-preservation","line":200,"observation_digest":"115977fceff3337bdd4321147b6164399a8989b883afeae566a98e98fffa6440","observation_id":"aro_v1_cfmxp7hp6mzxxxkdeekhwylehg","path":"packages/aws-durable-execution-conformance-tests/src/aws_durable_execution_conformance_tests/lmi/cloud.py","prior_finding_id":"","published_at":"2026-11-16T21:02:17Z","review_id":"arr_v1_tc4czfqdlkdoxjjc65zlzy4ham","reviewed_base_sha":"30915949a9f08023f6227357338d3a7cf1495313","reviewed_head_sha":"793ecdc6b3528433e80da25622c85749ff8b1323","reviewer":"codex","start_line":200,"suggestion_id":"arsg_v1_jjprekhvmyt6rk7mvc22erwo7g"},"pull_request":{"number":186},"record_id":"art_v1_tzplfu6gtw4mbiz65wu5rlbty7","record_type":"finding_observed","recorded_at":"2026-11-16T21:02:17Z","repository":{"full_name":"aws/aws-durable-execution-conformance-tests","id":1303200455},"schema_version":1}
