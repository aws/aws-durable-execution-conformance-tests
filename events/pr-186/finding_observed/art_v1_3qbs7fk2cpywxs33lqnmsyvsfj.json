{"data":{"body":"[P1] Preserve unresolved retirement across workflow runs\n\nThis still discards `quiescent=False`, leaving quarantine only in the current process. After the workflow releases its concurrency slot, the next deployment checks only for `RUNNING` durable executions. A terminal execution with an unretired native task therefore permits another deployment without reconciling that task. Persist unresolved retirement by target and require positive reconciliation before subsequent deployment or admission.","comment_node_id":"","finding_digest":"2e292d99d8d19fac03eb9de307276fc4a650932ad8c0cf6675a6310bf18e3800","finding_id":"arf_v1_fyus3goy2gp2ya7ltxrqoj3pys","finding_key":"lmi/adapter.py::sharedadapter.finish::cross-run-quarantine-loss","identity_key":"lmi/adapter.py::sharedadapter.finish::cross-run-quarantine-loss","line":231,"observation_digest":"b72ff07a7c43d87a5fc56c6b293b8c998626b4daae773f09082630a02419c528","observation_id":"aro_v1_w4x7a6t4ipmhux6fnrvsso4mtg","path":"packages/aws-durable-execution-conformance-tests/src/aws_durable_execution_conformance_tests/lmi/adapter.py","prior_finding_id":"arf_v1_fyus3goy2gp2ya7ltxrqoj3pys","published_at":"2026-11-16T19:37:02Z","review_id":"arr_v1_vkkb4pne4gnjmf67keitalbv6l","reviewed_base_sha":"30915949a9f08023f6227357338d3a7cf1495313","reviewed_head_sha":"217d595957c35c4370d811b5b6169e00bce8ef9f","reviewer":"codex","start_line":228,"suggestion_id":"","suppressed":true,"suppression_status":"out-of-scope"},"pull_request":{"number":186},"record_id":"art_v1_3qbs7fk2cpywxs33lqnmsyvsfj","record_type":"finding_observed","recorded_at":"2026-11-16T19:37:02Z","repository":{"full_name":"aws/aws-durable-execution-conformance-tests","id":1303200455},"schema_version":1}
