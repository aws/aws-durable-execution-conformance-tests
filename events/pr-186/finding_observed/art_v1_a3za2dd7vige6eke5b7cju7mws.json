{"data":{"body":"[P1] Preserve unresolved retirement across workflow runs\n\nThis still ignores `quiescent=False`, leaving quarantine only in the current process. After the workflow releases its concurrency group, the next deployment checks only for `RUNNING` durable executions. A terminal execution with unretired native work therefore permits another deployment without reconciling that work. Persist unresolved retirement by target and require positive reconciliation before subsequent deployment or admission.","comment_node_id":"","finding_digest":"2e292d99d8d19fac03eb9de307276fc4a650932ad8c0cf6675a6310bf18e3800","finding_id":"arf_v1_fyus3goy2gp2ya7ltxrqoj3pys","finding_key":"lmi/adapter.py::sharedadapter.finish::cross-run-quarantine-loss","identity_key":"lmi/adapter.py::sharedadapter.finish::cross-run-quarantine-loss","line":231,"observation_digest":"66b81919ed88aee18000f7946b2e625f9f0cebf2ddc62372f03ca5acf35facb6","observation_id":"aro_v1_m24bsgpnrcxodaaa66kgwltcl6","path":"packages/aws-durable-execution-conformance-tests/src/aws_durable_execution_conformance_tests/lmi/adapter.py","prior_finding_id":"arf_v1_fyus3goy2gp2ya7ltxrqoj3pys","published_at":"2026-11-16T19:59:42Z","review_id":"arr_v1_netjgvrwfm4opnungrjrt5gmu5","reviewed_base_sha":"30915949a9f08023f6227357338d3a7cf1495313","reviewed_head_sha":"7f6c01eee57e7c48a2e4dde39a4fdc5507ca078e","reviewer":"codex","start_line":228,"suggestion_id":"","suppressed":true,"suppression_status":"out-of-scope"},"pull_request":{"number":186},"record_id":"art_v1_a3za2dd7vige6eke5b7cju7mws","record_type":"finding_observed","recorded_at":"2026-11-16T19:59:42Z","repository":{"full_name":"aws/aws-durable-execution-conformance-tests","id":1303200455},"schema_version":1}
