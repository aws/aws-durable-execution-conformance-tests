{"data":{"body":"[P2] Check retained cohort coverage for caller-owned suites too\n\nThis check runs only when `suite is None`. With a `SuiteDefinition`, a manifest declaring victim, peer, and spare still accepts ordinary two-role evidence through the supplied common validator, although live validation rejects the missing spare. Resolve the case definition with the supplied suite and apply this role comparison to both branches. Extend the retained-evidence regression to caller-owned suites.","comment_node_id":"PRRC_kwDOTa1Cx88AAAABEait3A","finding_digest":"54c7c0b9b417020fcdddf2166b79857f11faa12b38cfff449eb9f5dc3f1c0cc8","finding_id":"arf_v1_ktd4bonuc4ba7to56ilgw6mfp4","finding_key":"lmi/app.py::_identity_errors::retained-evidence-role-coverage","identity_key":"lmi/app.py::_identity_errors::retained-evidence-role-coverage","line":290,"observation_digest":"689a25a8e398d39fa2936b6ecc54bb98a4b2227f1156422e278cbdb9f9d7238d","observation_id":"aro_v1_ncnclkhdtdjz7iutnnxmyvf3tc","path":"packages/aws-durable-execution-conformance-tests/src/aws_durable_execution_conformance_tests/lmi/app.py","prior_finding_id":"arf_v1_ktd4bonuc4ba7to56ilgw6mfp4","published_at":"2026-11-16T20:38:48Z","review_id":"arr_v1_yjso2wadzlukb3k4iflv7qeesv","reviewed_base_sha":"30915949a9f08023f6227357338d3a7cf1495313","reviewed_head_sha":"76732458015d4437e06de061636a61ca2c9558d2","reviewer":"codex","start_line":287,"suggestion_id":""},"pull_request":{"number":186},"record_id":"art_v1_gfjhdxrem42f6o5h6xrgktind4","record_type":"finding_observed","recorded_at":"2026-11-16T20:38:48Z","repository":{"full_name":"aws/aws-durable-execution-conformance-tests","id":1303200455},"schema_version":1}
