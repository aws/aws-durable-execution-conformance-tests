{"data":{"body":"[P1] Preserve unresolved retirement across workflow runs\n\n`finish()` ignores `quiescent=False`, so quarantine disappears with the current process. After the workflow releases its concurrency group, the next deployment checks only for RUNNING durable executions. A terminal execution with outstanding native work therefore permits deployment and admission without reconciliation. Persist unresolved retirement by target and require positive reconciliation before subsequent deployment or admission.","comment_node_id":"","finding_digest":"2e292d99d8d19fac03eb9de307276fc4a650932ad8c0cf6675a6310bf18e3800","finding_id":"arf_v1_fyus3goy2gp2ya7ltxrqoj3pys","finding_key":"lmi/adapter.py::sharedadapter.finish::cross-run-quarantine-loss","identity_key":"lmi/adapter.py::sharedadapter.finish::cross-run-quarantine-loss","line":231,"observation_digest":"8e70862d90c0b529422c7d18d3b5249a7f0eeb6819a231df556a6fe7092f5f89","observation_id":"aro_v1_rzyimlmqyc2ssqrmpumnhnjetj","path":"packages/aws-durable-execution-conformance-tests/src/aws_durable_execution_conformance_tests/lmi/adapter.py","prior_finding_id":"arf_v1_fyus3goy2gp2ya7ltxrqoj3pys","published_at":"2026-11-16T23:06:25Z","review_id":"arr_v1_vfkwcolvpqou232nbjxpquuzuv","reviewed_base_sha":"30915949a9f08023f6227357338d3a7cf1495313","reviewed_head_sha":"a0aa772066697c1eb44bfcd98b904a663112c5bc","reviewer":"codex","start_line":228,"suggestion_id":"","suppressed":true,"suppression_status":"out-of-scope"},"pull_request":{"number":186},"record_id":"art_v1_clsg6nx5wsq6r7ayha6aaesjnv","record_type":"finding_observed","recorded_at":"2026-11-16T23:06:25Z","repository":{"full_name":"aws/aws-durable-execution-conformance-tests","id":1303200455},"schema_version":1}
