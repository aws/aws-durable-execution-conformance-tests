{"data":{"body":"[P1] Preserve unresolved retirement across workflow runs\n\n`quiescent=False` is ignored, leaving quarantine only in the current process. After the workflow releases its concurrency group, the next deployment checks only for RUNNING durable executions. A terminal execution with unretired native work therefore permits another deployment without reconciliation. Persist unresolved retirement by target and require positive reconciliation before subsequent deployment or admission.","comment_node_id":"","finding_digest":"2e292d99d8d19fac03eb9de307276fc4a650932ad8c0cf6675a6310bf18e3800","finding_id":"arf_v1_fyus3goy2gp2ya7ltxrqoj3pys","finding_key":"lmi/adapter.py::sharedadapter.finish::cross-run-quarantine-loss","identity_key":"lmi/adapter.py::sharedadapter.finish::cross-run-quarantine-loss","line":231,"observation_digest":"364c71a3973d20d649d8d37443c24d0e88b33850a7b0111d7c87f4510e52bd79","observation_id":"aro_v1_gzghdi4xhuqnmsoy2n2ehqsnb2","path":"packages/aws-durable-execution-conformance-tests/src/aws_durable_execution_conformance_tests/lmi/adapter.py","prior_finding_id":"arf_v1_fyus3goy2gp2ya7ltxrqoj3pys","published_at":"2026-11-16T22:30:46Z","review_id":"arr_v1_gitfawrmpthxmt7tw77onot5bu","reviewed_base_sha":"30915949a9f08023f6227357338d3a7cf1495313","reviewed_head_sha":"8c418ae7b5801c2d9fdf71f6124a986f142c3726","reviewer":"codex","start_line":228,"suggestion_id":"","suppressed":true,"suppression_status":"out-of-scope"},"pull_request":{"number":186},"record_id":"art_v1_o6hcqmp2e2vkvngx2oieujme5z","record_type":"finding_observed","recorded_at":"2026-11-16T22:30:46Z","repository":{"full_name":"aws/aws-durable-execution-conformance-tests","id":1303200455},"schema_version":1}
