{"data":{"body":"[P1] Preserve unresolved retirement across workflow runs\n\n`quiescent=False` is still ignored, leaving quarantine only in the current process. Once the workflow releases its concurrency group, the next deployment checks only for RUNNING durable executions. A terminal execution with unretired native work therefore permits another deployment without reconciliation. Persist unresolved retirement by target and require positive reconciliation before subsequent deployment or admission.","comment_node_id":"","finding_digest":"2e292d99d8d19fac03eb9de307276fc4a650932ad8c0cf6675a6310bf18e3800","finding_id":"arf_v1_fyus3goy2gp2ya7ltxrqoj3pys","finding_key":"lmi/adapter.py::sharedadapter.finish::cross-run-quarantine-loss","identity_key":"lmi/adapter.py::sharedadapter.finish::cross-run-quarantine-loss","line":231,"observation_digest":"48ca97632ba68c07b316c839592e88c84c9d0df0d7e027ce944d5fbcc12882ba","observation_id":"aro_v1_jdfjoyzlu2gapmywza4vsluizb","path":"packages/aws-durable-execution-conformance-tests/src/aws_durable_execution_conformance_tests/lmi/adapter.py","prior_finding_id":"arf_v1_fyus3goy2gp2ya7ltxrqoj3pys","published_at":"2026-11-16T20:38:52Z","review_id":"arr_v1_yjso2wadzlukb3k4iflv7qeesv","reviewed_base_sha":"30915949a9f08023f6227357338d3a7cf1495313","reviewed_head_sha":"76732458015d4437e06de061636a61ca2c9558d2","reviewer":"codex","start_line":228,"suggestion_id":"","suppressed":true,"suppression_status":"out-of-scope"},"pull_request":{"number":186},"record_id":"art_v1_xfpptoxes33v7z4d54dimulbbf","record_type":"finding_observed","recorded_at":"2026-11-16T20:38:52Z","repository":{"full_name":"aws/aws-durable-execution-conformance-tests","id":1303200455},"schema_version":1}
