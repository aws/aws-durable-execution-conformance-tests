{"data":{"body":"[P1] Preserve unresolved retirement across workflow runs\n\nThis still discards `quiescent=False`, leaving quarantine only in the current process. After the workflow releases its concurrency slot, the next deployment checks only for `RUNNING` durable executions. A terminal execution with an unretired native task therefore permits another deployment without reconciling that task. Persist unresolved retirement by target and require positive reconciliation before subsequent deployment or admission.","comment_node_id":"PRRC_kwDOTa1Cx88AAAABEZgcnw","finding_digest":"2e292d99d8d19fac03eb9de307276fc4a650932ad8c0cf6675a6310bf18e3800","finding_id":"arf_v1_fyus3goy2gp2ya7ltxrqoj3pys","finding_key":"lmi/adapter.py::sharedadapter.finish::cross-run-quarantine-loss","identity_key":"lmi/adapter.py::sharedadapter.finish::cross-run-quarantine-loss","line":223,"observation_digest":"5e85d97f3c16a945ce73fe6346b61f4f337835e09e449a26b1e968b103a74451","observation_id":"aro_v1_l2c5s7z4c2uulttt7zrunnq7j4","path":"packages/aws-durable-execution-conformance-tests/src/aws_durable_execution_conformance_tests/lmi/adapter.py","prior_finding_id":"arf_v1_fyus3goy2gp2ya7ltxrqoj3pys","published_at":"2026-11-16T19:01:39Z","review_id":"arr_v1_2d7a5372jk3g2rs2vombwout3y","reviewed_base_sha":"30915949a9f08023f6227357338d3a7cf1495313","reviewed_head_sha":"638a90d5a51a990e1eda663b5c2c13f4db777354","reviewer":"codex","start_line":220,"suggestion_id":""},"pull_request":{"number":186},"record_id":"art_v1_ct5otxfvkommcjobpomn6q24co","record_type":"finding_observed","recorded_at":"2026-11-16T19:01:39Z","repository":{"full_name":"aws/aws-durable-execution-conformance-tests","id":1303200455},"schema_version":1}
