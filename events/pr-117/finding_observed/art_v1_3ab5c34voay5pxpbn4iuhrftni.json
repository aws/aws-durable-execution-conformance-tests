{"data":{"body":"**[P2] Document the Dash0 exporter authorization header**\n\n`DASH0_AUTH_TOKEN` authenticates only the backend query; the community exporter reads authentication from `OTEL_EXPORTER_OTLP_HEADERS`. Following this manual-run guidance therefore sends unauthenticated telemetry to the ingress endpoint. Explicitly map the token into the Bearer header and include the required exporter/backend arguments.","comment_node_id":"PRRC_kwDOTa1Cx87svPar","finding_digest":"93c712a58ca70c92dd1264af7d4513b2639faaaccbd62324e0a09a9c4ed18231","finding_id":"arf_v1_spdrfjmmu4gjfxismsxx2ritwj","finding_key":"packages/aws-durable-execution-conformance-tests-otel/readme::dash0-manual-run::missing-exporter-auth-header","identity_key":"packages/aws-durable-execution-conformance-tests-otel/readme::dash0-manual-run::missing-exporter-auth-header","line":174,"observation_digest":"9088b591441f56ea072b2954c40442fd802de3c73804c23a317187786d3c3465","observation_id":"aro_v1_scelleked5loubzlffkmibcc7w","path":"packages/aws-durable-execution-conformance-tests-otel/README.md","prior_finding_id":"","published_at":"2026-09-09T18:37:50Z","review_id":"arr_v1_ld2f4r7x5mym3qcoyscxea2ffj","reviewed_base_sha":"df872a9dbfc4719d2d5b8ad86605b86c4e7c0a56","reviewed_head_sha":"95e76f77cb58feea709e5c724ba690625e7f83b3","reviewer":"codex","start_line":172,"suggestion_id":"arsg_v1_yj5egjbfapfihpvhiuzkwdmuoi"},"pull_request":{"number":117},"record_id":"art_v1_3ab5c34voay5pxpbn4iuhrftni","record_type":"finding_observed","recorded_at":"2026-09-09T18:37:50Z","repository":{"full_name":"aws/aws-durable-execution-conformance-tests","id":1303200455},"schema_version":1}
