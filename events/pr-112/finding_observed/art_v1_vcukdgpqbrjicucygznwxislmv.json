{"data":{"body":"**[P2] Preserve existing positional constructor arguments.** Inserting this field before `errors` and `duration_seconds` silently remaps positional `ReportEntry` calls made by extensions or report consumers, breaking compatibility within the core 1.x range. Make the new field keyword-only (or append it after all existing fields) and add a positional-construction regression test.","comment_node_id":"PRRC_kwDOTa1Cx87phcct","finding_digest":"4d727d87b18c32fea59a0ae59609f0c6557bfa75ce32616d285fbc81da5688ca","finding_id":"arf_v1_jvzh3b5rrqzp5jm2blszmcpqyz","finding_key":"packages/aws-durable-execution-conformance-tests/src/aws_durable_execution_conformance_tests/report.py::reportentry::positional-constructor-compatibility","identity_key":"packages/aws-durable-execution-conformance-tests/src/aws_durable_execution_conformance_tests/report.py::reportentry::positional-constructor-compatibility","line":73,"observation_digest":"b322e3b47eab01c537a37e4f67a7c49f599f29b54141b8516444b540a1bf30bd","observation_id":"aro_v1_wmrohnd6vma4kn5dpzhwpj6et5","path":"packages/aws-durable-execution-conformance-tests/src/aws_durable_execution_conformance_tests/report.py","prior_finding_id":"","published_at":"2026-09-02T19:28:48Z","review_id":"arr_v1_oj3agorfvljxrr453hoxwegx6s","reviewed_base_sha":"f42275ac3fa0134288e36e132fa72c8708f739fa","reviewed_head_sha":"43976bdc61aa76e97b577e3de55ef3cd2c20ac93","reviewer":"codex","start_line":73,"suggestion_id":"arsg_v1_il3dj54rahpxe4i64ee5hxujji"},"pull_request":{"number":112},"record_id":"art_v1_vcukdgpqbrjicucygznwxislmv","record_type":"finding_observed","recorded_at":"2026-09-02T19:28:48Z","repository":{"full_name":"aws/aws-durable-execution-conformance-tests","id":1303200455},"schema_version":1}
