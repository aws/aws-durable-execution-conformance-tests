{"data":{"body":"**[P2] Allow empty selected suites to reach coverage reporting.** With `--suite static_typing` and no mapped `12-*` handlers, the earlier empty-description exit runs before this loop. The requirements therefore never appear as optional `UNCOVERED`, and requested JSON/JUnit reports are not created. Continue to report construction with `results=[]` when the selected suite has no mappings, and add an integration test for that case.","comment_node_id":"PRRC_kwDOTa1Cx87phcae","finding_digest":"dfeefede87fc173c8e2eb4a0fed0a211d1f25bea696e855b8bfdd7b35f93faee","finding_id":"arf_v1_37xp5xuh7qltzdrowsqp5ufcch","finding_key":"packages/aws-durable-execution-conformance-tests/src/aws_durable_execution_conformance_tests/app.py::_deploy_validate_report::empty-selected-suite-coverage","identity_key":"packages/aws-durable-execution-conformance-tests/src/aws_durable_execution_conformance_tests/app.py::_deploy_validate_report::empty-selected-suite-coverage","line":432,"observation_digest":"e22817beeb1c01090abf472153a0589dc6c2bec1744831ecc77ac81f06d32ba3","observation_id":"aro_v1_4iubppxldqaqscv7i4qvhicytx","path":"packages/aws-durable-execution-conformance-tests/src/aws_durable_execution_conformance_tests/app.py","prior_finding_id":"","published_at":"2026-09-02T19:28:47Z","review_id":"arr_v1_oj3agorfvljxrr453hoxwegx6s","reviewed_base_sha":"f42275ac3fa0134288e36e132fa72c8708f739fa","reviewed_head_sha":"43976bdc61aa76e97b577e3de55ef3cd2c20ac93","reviewer":"codex","start_line":432,"suggestion_id":""},"pull_request":{"number":112},"record_id":"art_v1_pg3jjl6gqfndtc62nsxcohmd23","record_type":"finding_observed","recorded_at":"2026-09-02T19:28:47Z","repository":{"full_name":"aws/aws-durable-execution-conformance-tests","id":1303200455},"schema_version":1}
